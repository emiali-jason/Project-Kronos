pcaVersionSupported(string actualVersion, string supportedVersion) =>
    actualVersion == supportedVersion

pcaMandatoryStringPresent(string value) =>
    value != ""

pcaContractIntegrity(string source, string boundary, int timestamp, bool versionSupported, bool mandatoryFieldsPresent, bool semanticCompatible, string sourceIntegrity) =>
    string status = not versionSupported ? PCA_INTEGRITY_INVALID : not mandatoryFieldsPresent ? PCA_INTEGRITY_INVALID : not semanticCompatible ? PCA_INTEGRITY_DEGRADED : sourceIntegrity
    string reason = not versionSupported ? "Unsupported mandatory contract version — fail closed" : not mandatoryFieldsPresent ? PCA_CONTRACT_INVALID : not semanticCompatible ? PCA_UPSTREAM_INCONSISTENT : "Contract valid"
    PCAIntegrityRecord.new(status, source, boundary, timestamp, reason)

pcaEvidenceField(string identity, string value, string source, string measurement, bool available, bool valid, string boundary, int timestamp, bool conflict, string unavailableReason) =>
    string validity = not available ? PCA_INTEGRITY_NOT_EVALUATED : valid ? PCA_INTEGRITY_VALID : PCA_INTEGRITY_INVALID
    string availability = available ? "AVAILABLE" : PCA_INTEGRITY_UNAVAILABLE
    string freshness = available ? "CURRENT" : PCA_INTEGRITY_UNKNOWN
    string conflictState = conflict ? "CONFLICT" : "NONE"
    string reason = not available ? unavailableReason : not valid ? "Evidence invalid" : conflict ? "Conflicting evidence preserved" : "Observed"
    PCAEvidenceFieldRecord.new(identity, value, source, measurement, validity, availability, freshness, boundary, timestamp, conflictState, reason)

pcaPackageBReadinessState(bool setupVersionCompatible, bool contextVersionCompatible, bool setupFieldsPresent, bool setupSemanticCompatible, string eligibility, bool contextAvailable, bool contextFailed, bool contextQualified, bool contextPending, bool readySetup, bool opportunityMissing) =>
    string state = not setupVersionCompatible or not contextVersionCompatible ? "READINESS INVALID" : not setupFieldsPresent ? "READINESS INVALID" : not setupSemanticCompatible ? "READINESS INCONSISTENT" : eligibility == "INELIGIBLE" ? "INELIGIBLE" : eligibility == "UNKNOWN" ? "READINESS UNKNOWN" : eligibility == "UNAVAILABLE" ? "READINESS UNAVAILABLE" : not contextAvailable ? "READINESS UNAVAILABLE" : contextFailed ? "BLOCKED" : contextQualified ? "QUALIFIED" : readySetup and opportunityMissing ? "NOT YET QUALIFIED" : contextPending ? "QUALIFICATION IN PROGRESS" : "NOT EVALUATED"
    state

pcaPackageBPrimaryBlocker(bool setupConsumable, string setupStatus, bool contextVersionCompatible, string eligibility, string contextBlockerIdentity) =>
    string identity = not setupConsumable ? setupStatus : not contextVersionCompatible ? "Unsupported Legacy Context Version" : eligibility == "INELIGIBLE" ? "Upstream Setup Ineligible" : eligibility == "UNKNOWN" ? "Upstream Setup Eligibility Unknown" : eligibility == "UNAVAILABLE" ? "Upstream Setup Eligibility Unavailable" : contextBlockerIdentity
    identity

pcaPackageBNextRequiredEvent(string blockerIdentity) =>
    string nextEvent = blockerIdentity == "NONE" ? "NONE" : blockerIdentity == "Opportunity Pending" ? "A direction-aligned Opportunity is published" : blockerIdentity == "Confirmation Pending" ? "The current MCX 1H observation boundary completes" : blockerIdentity == "Review Barrier Veto" ? "The underlying barrier interaction clears" : blockerIdentity == "Upstream Setup Ineligible" ? "KR-370 publishes an eligible valid setup" : "Readiness inputs satisfy the approved policy"
    nextEvent

pcaPackageBOptionalSupportSummary(bool momentumSupport, bool expansionRelease, bool rangeSupport, bool acceptanceSupport, bool referenceMomentumSupport) =>
    (momentumSupport ? "Momentum strong" : "Momentum support inactive") + " | " + (expansionRelease ? "Expansion released" : "Expansion support inactive") + " | " + (rangeSupport ? "COMEX 4H range supportive" : "COMEX 4H range support inactive") + " | " + (acceptanceSupport ? "COMEX 4H acceptance supportive" : "COMEX 4H acceptance support inactive") + " | " + (referenceMomentumSupport ? "COMEX 1H momentum supportive" : "COMEX 1H momentum support inactive")

pcaPackageBReductionSummary(bool compressionReduction, bool momentumReduction, bool dailyReferenceOpposes, bool dailyReferenceAvailable, bool reviewReduction, bool extensionReduction) =>
    (compressionReduction ? "Compression active" : "Compression clear") + " | " + (momentumReduction ? "Momentum weak" : "Momentum reduction inactive") + " | " + (dailyReferenceOpposes ? "Daily reference opposes" : dailyReferenceAvailable ? "Daily reference aligned" : "Daily reference not evaluated") + " | " + (reviewReduction ? "Review context reducing" : "Review context reduction inactive") + " | " + (extensionReduction ? "Extension active" : "Extension reduction inactive")

pcaPackageCSetupLifecycle(string currentIdentity, string currentState, string currentMaturity, string currentBlocker) =>
    string priorIdentity = bar_index > 0 ? currentIdentity[1] : PCA_INTEGRITY_NOT_EVALUATED
    string priorState = bar_index > 0 ? currentState[1] : PCA_INTEGRITY_NOT_EVALUATED
    string priorBlocker = bar_index > 0 ? currentBlocker[1] : "NONE"
    bool firstAssessment = bar_index == 0
    bool sameState = not firstAssessment and currentState == priorState and currentIdentity == priorIdentity
    bool expired = not firstAssessment and (currentState == "SETUP EXPIRED" or currentMaturity == "EXPIRED")
    bool replaced = not firstAssessment and currentIdentity != priorIdentity and currentState != "NO SETUP" and priorState != "NO SETUP"
    bool reset = not firstAssessment and not expired and not replaced and currentState == "NO SETUP" and priorState != "NO SETUP"
    bool priorFavorable = priorState == "SETUP VALID" or priorState == "WATCH LONG" or priorState == "WATCH SHORT"
    bool currentFavorable = currentState == "SETUP VALID" or currentState == "WATCH LONG" or currentState == "WATCH SHORT"
    bool regressed = not firstAssessment and not expired and not replaced and not reset and priorFavorable and not currentFavorable
    string assessmentStatus = firstAssessment ? "NEWLY ASSESSED" : expired ? "EXPIRED" : replaced or reset ? "RESET" : regressed ? "REGRESSED" : sameState ? "CONTINUING" : "NEWLY ASSESSED"
    string lifecycleStatus = expired ? "EXPIRED" : replaced ? "REPLACED" : reset ? "RESET" : sameState ? "PERSISTING" : "ACTIVE"
    string cause = firstAssessment ? "Initial setup assessment" : expired ? "KR-370 published setup expiry" : replaced ? "Setup identity changed from " + priorIdentity + " to " + currentIdentity : reset ? "No qualifying setup remains at the current observation boundary" : priorBlocker != "NONE" and currentBlocker == "NONE" ? "Analytical blocker cleared: " + priorBlocker : priorBlocker != currentBlocker ? "Analytical blocker changed from " + priorBlocker + " to " + currentBlocker : regressed ? "Setup regressed from " + priorState + " to " + currentState : sameState ? "Setup state and identity persist" : "Governed setup evidence changed"
    string rule = PCA_PACKAGE_C_POLICY_IDENTITY + " — KR-370 setup lifecycle"
    string persistenceStatus = sameState ? "PERSISTING" : "NOT PERSISTING"
    string regressionStatus = regressed ? "REGRESSED — " + cause : "NOT REGRESSED"
    string resetStatus = replaced or reset ? "RESET — " + cause : "NOT RESET"
    string expiryStatus = expired ? "EXPIRED — " + cause : "NOT EXPIRED"
    PCALifecycleEvaluation.new(priorIdentity, priorState, lifecycleStatus, persistenceStatus, regressionStatus, resetStatus, expiryStatus, cause, rule, assessmentStatus)

pcaPackageCReadinessLifecycle(string currentSetupIdentity, string currentState, string currentBlocker) =>
    string priorSetupIdentity = bar_index > 0 ? currentSetupIdentity[1] : PCA_INTEGRITY_NOT_EVALUATED
    string priorState = bar_index > 0 ? currentState[1] : PCA_INTEGRITY_NOT_EVALUATED
    string priorBlocker = bar_index > 0 ? currentBlocker[1] : "NONE"
    bool firstAssessment = bar_index == 0
    bool sameState = not firstAssessment and currentState == priorState and currentSetupIdentity == priorSetupIdentity
    bool expired = not firstAssessment and currentState == "EXPIRED FOR ACTION"
    bool reset = not firstAssessment and not expired and currentSetupIdentity != priorSetupIdentity
    bool priorProgressing = priorState == "QUALIFIED" or priorState == "QUALIFICATION IN PROGRESS" or priorState == "NOT YET QUALIFIED"
    bool currentAdverse = currentState == "INELIGIBLE" or currentState == "BLOCKED" or currentState == "DEFERRED" or currentState == "SUSPENDED" or currentState == "READINESS UNKNOWN" or currentState == "READINESS UNAVAILABLE" or currentState == "READINESS INVALID" or currentState == "READINESS STALE" or currentState == "READINESS DEGRADED" or currentState == "READINESS INCONSISTENT"
    bool regressed = not firstAssessment and not expired and not reset and priorProgressing and currentAdverse
    string assessmentStatus = firstAssessment ? "NEWLY ASSESSED" : expired ? "EXPIRED" : reset ? "RESET" : regressed ? "REGRESSED" : sameState ? "CONTINUING" : "NEWLY ASSESSED"
    string cause = firstAssessment ? "Initial readiness assessment" : expired ? "KR-380A published action-opportunity expiry" : reset ? "Upstream setup identity changed from " + priorSetupIdentity + " to " + currentSetupIdentity : priorBlocker != "NONE" and currentBlocker == "NONE" ? "Readiness blocker cleared: " + priorBlocker : priorBlocker != currentBlocker ? "Readiness blocker changed from " + priorBlocker + " to " + currentBlocker : regressed ? "Readiness regressed from " + priorState + " to " + currentState : sameState ? "Readiness state and upstream setup identity persist" : "Governed readiness inputs changed"
    string rule = PCA_PACKAGE_C_POLICY_IDENTITY + " — KR-380A readiness lifecycle"
    string persistenceStatus = sameState ? "PERSISTING" : "NOT PERSISTING"
    string regressionStatus = regressed ? "REGRESSED — " + cause : "NOT REGRESSED"
    string resetStatus = reset ? "RESET — " + cause : "NOT RESET"
    string expiryStatus = expired ? "EXPIRED — " + cause : "NOT EXPIRED"
    PCALifecycleEvaluation.new(priorSetupIdentity, priorState, assessmentStatus, persistenceStatus, regressionStatus, resetStatus, expiryStatus, cause, rule, assessmentStatus)

pcaPackageCCanonicalLifecycle(string currentState, string setupAssessmentStatus, string readinessAssessmentStatus, string currentBlocker) =>
    string priorState = bar_index > 0 ? currentState[1] : PCA_INTEGRITY_NOT_EVALUATED
    string priorBlocker = bar_index > 0 ? currentBlocker[1] : "NONE"
    bool firstAssessment = bar_index == 0
    bool sameState = not firstAssessment and currentState == priorState
    bool expired = not firstAssessment and (setupAssessmentStatus == "EXPIRED" or readinessAssessmentStatus == "EXPIRED")
    bool reset = not firstAssessment and not expired and (setupAssessmentStatus == "RESET" or readinessAssessmentStatus == "RESET")
    bool priorFavorable = priorState == "WATCH LONG" or priorState == "WATCH SHORT" or priorState == "LONG SETUP VALID — NOT READY" or priorState == "SHORT SETUP VALID — NOT READY" or priorState == "LONG ACTION READINESS QUALIFIED" or priorState == "SHORT ACTION READINESS QUALIFIED"
    bool currentAdverse = currentState == "NO ANALYTICAL SETUP" or currentState == "READINESS BLOCKED" or currentState == "ANALYTICALLY BLOCKED" or currentState == "NO ACTIONABLE PINE CANDIDATE" or currentState == "DIRECTIONALLY CONFLICTED" or currentState == "UPSTREAM INCONSISTENT" or currentState == "PINE STATE UNKNOWN" or currentState == "PINE STATE UNAVAILABLE" or currentState == "PINE STATE DEGRADED" or currentState == "PINE STATE STALE"
    bool regressed = not firstAssessment and not expired and not reset and (setupAssessmentStatus == "REGRESSED" or readinessAssessmentStatus == "REGRESSED" or priorFavorable and currentAdverse)
    string assessmentStatus = firstAssessment ? "NEWLY ASSESSED" : expired ? "EXPIRED" : reset ? "RESET" : regressed ? "REGRESSED" : sameState ? "CONTINUING" : "NEWLY ASSESSED"
    string cause = firstAssessment ? "Initial canonical Pine state assessment" : expired ? "Upstream lifecycle expired" : reset ? "Upstream lifecycle reset" : priorBlocker != "NONE" and currentBlocker == "NONE" ? "Authoritative upstream blocker cleared: " + priorBlocker : priorBlocker != currentBlocker ? "Authoritative upstream blocker changed from " + priorBlocker + " to " + currentBlocker : regressed ? "Canonical Pine state regressed from " + priorState + " to " + currentState : sameState ? "Canonical Pine state persists" : "Authoritative source state changed"
    string rule = PCA_PACKAGE_C_POLICY_IDENTITY + " — KR-380 current-state presentation"
    string persistenceStatus = sameState ? "PERSISTING" : "NOT PERSISTING"
    string regressionStatus = regressed ? "REGRESSED — " + cause : "NOT REGRESSED"
    string resetStatus = reset ? "RESET — " + cause : "NOT RESET"
    string expiryStatus = expired ? "EXPIRED — " + cause : "NOT EXPIRED"
    PCALifecycleEvaluation.new(PCA_INTEGRITY_NOT_EVALUATED, priorState, assessmentStatus, persistenceStatus, regressionStatus, resetStatus, expiryStatus, cause, rule, assessmentStatus)

string pcaObservationBoundary = syminfo.tickerid + " | " + timeframe.period + " | " + (barstate.isconfirmed ? "COMPLETED" : "LIVE")
int pcaObservationTimestamp = time_close



//==================================================================
// KR-360 : Evidence Contract Producer / Legacy Confidence Compatibility
// Version : 1.0.0
// Status  : FROZEN
// Last Updated : 2026-07-09
//
// Purpose:
// Synthesizes completed KRONOS engines into a single confidence
// assessment. Does not generate trading decisions.
//
// Validation Scope:
// - Confidence architecture and scoring freeze on Copper, Gold, and
//   Silver.
//
// Frozen Contract:
// - Uses ONLY public outputs from prior engines.
// - No direct market calculations.
// - No alerts.
// - No buy/sell decisions.
//==================================================================

//==================================================================
// KR-360.10 CONFIDENCE STATE CONSTANTS
//==================================================================

const int KR360_CONFIDENCE_AVOID = 0
const int KR360_CONFIDENCE_LOW = 1
const int KR360_CONFIDENCE_DEVELOPING = 2
const int KR360_CONFIDENCE_HIGH = 3
const int KR360_CONFIDENCE_EXCEPTIONAL = 4

//==================================================================
// KR-360.20 INPUT READINESS
//==================================================================

bool confidenceTrendReady = outConsolidatedDirectionalReady
bool confidenceQualityReady = outEvidenceReady
bool confidenceCompressionReady = outCompressionReady
bool confidenceAcceptanceReady = outBarrierReady
bool confidenceMomentumReady = outMomentumReady
bool confidenceReviewReady = outReviewInputReady
bool confidenceOpportunityReady = outOpportunityInputReady

bool confidenceReady = confidenceTrendReady and confidenceCompressionReady and confidenceAcceptanceReady and confidenceReviewReady and confidenceOpportunityReady

//==================================================================
// KR-360.30 PUBLIC CONDITION MAP
//==================================================================

bool confidenceDirectionalTrend = confidenceTrendReady and (outConsolidatedBullishBias or outConsolidatedBearishBias)
bool confidenceConfirmedTrend = confidenceDirectionalTrend and (outConfirmedBullishTrend or outConfirmedBearishTrend)
bool confidenceDevelopingTrend = confidenceDirectionalTrend and (outDevelopingBullishTrend or outDevelopingBearishTrend)
bool confidenceNeutralTrend = confidenceTrendReady and outConsolidatedNeutralConflictedBias

bool confidenceHealthyQuality = confidenceQualityReady and (outTrendQualityHealthy or outTrendQualityExcellent)
bool confidenceWeakQuality = confidenceQualityReady and outTrendQualityWeak
bool confidenceExtendedQuality = confidenceQualityReady and outTrendQualityExtended

bool confidenceRejectedAcceptance = confidenceAcceptanceReady and outAcceptanceRejected
bool confidenceAccepted = confidenceAcceptanceReady and outAcceptanceAccepted
bool confidenceStrongAcceptance = confidenceAcceptanceReady and outAcceptanceStrong
bool confidenceTestingAcceptance = confidenceAcceptanceReady and outAcceptanceTesting

bool confidenceCompressionBuilding = confidenceCompressionReady and outCompressionBuilding and not outExpansionStarted
bool confidenceExpansionRelease = confidenceCompressionReady and outExpansionStarted

bool confidenceStrongMomentum = confidenceMomentumReady and (outMomentumStrong or outMomentumBuilding)
bool confidenceNormalMomentum = confidenceMomentumReady and outMomentumNormal
bool confidenceExhaustedMomentum = confidenceMomentumReady and outMomentumExhausted

bool confidenceHighOpportunity = confidenceOpportunityReady and (outBullishOpportunityContext or outBearishOpportunityContext)
bool confidenceLimitedOpportunity = confidenceOpportunityReady and outNoOpportunityContext

bool confidenceHighRisk = confidenceReviewReady and outReviewBlocked
bool confidenceLowRisk = confidenceReviewReady and outReviewReady

//==================================================================
// KR-360.40 BOOSTERS AND PENALTIES
//==================================================================

int confidenceTrendBoost = confidenceConfirmedTrend ? 18 : confidenceDevelopingTrend or confidenceDirectionalTrend ? 10 : 0
int confidenceQualityBoost = confidenceHealthyQuality ? 12 : 0
int confidenceAcceptanceBoost = confidenceStrongAcceptance ? 18 : confidenceAccepted ? 14 : confidenceTestingAcceptance ? 6 : 0
int confidenceCompressionBoost = confidenceExpansionRelease ? 12 : 0
int confidenceMomentumBoost = confidenceStrongMomentum ? 12 : confidenceNormalMomentum ? 5 : 0
int confidenceOpportunityBoost = confidenceHighOpportunity ? 12 : 0
int confidenceRiskBoost = confidenceLowRisk ? 8 : 0

int confidenceTrendPenalty = confidenceNeutralTrend ? -25 : 0
int confidenceQualityPenalty = confidenceWeakQuality ? -12 : confidenceExtendedQuality ? -8 : 0
int confidenceAcceptancePenalty = confidenceRejectedAcceptance ? -25 : 0
int confidenceCompressionPenalty = confidenceCompressionBuilding ? -10 : 0
int confidenceMomentumPenalty = confidenceExhaustedMomentum ? -18 : 0
int confidenceOpportunityPenalty = confidenceLimitedOpportunity ? -12 : 0
int confidenceRiskPenalty = confidenceHighRisk ? -25 : 0

int confidenceBoostScore = confidenceTrendBoost + confidenceQualityBoost + confidenceAcceptanceBoost + confidenceCompressionBoost + confidenceMomentumBoost + confidenceOpportunityBoost + confidenceRiskBoost
int confidencePenaltyScore = confidenceTrendPenalty + confidenceQualityPenalty + confidenceAcceptancePenalty + confidenceCompressionPenalty + confidenceMomentumPenalty + confidenceOpportunityPenalty + confidenceRiskPenalty

//==================================================================
// KR-360.50 CONFIDENCE GATES
//==================================================================

int confidenceRawScore = 30 + confidenceBoostScore + confidencePenaltyScore
int confidenceGatedScore = confidenceRawScore

if confidenceNeutralTrend
    confidenceGatedScore := math.min(confidenceGatedScore, 20)

if confidenceRejectedAcceptance
    confidenceGatedScore := math.min(confidenceGatedScore, 30)

if confidenceHighRisk
    confidenceGatedScore := math.min(confidenceGatedScore, 40)

if confidenceCompressionBuilding
    confidenceGatedScore := math.min(confidenceGatedScore, 60)

if confidenceWeakQuality
    confidenceGatedScore := math.min(confidenceGatedScore, 55)

if confidenceLimitedOpportunity
    confidenceGatedScore := math.min(confidenceGatedScore, 60)

int confidenceScore = math.max(0, math.min(100, confidenceGatedScore))

//==================================================================
// KR-360.60 CONFIDENCE STATE AND REASON
//==================================================================

int confidenceState = KR360_CONFIDENCE_AVOID

if confidenceScore <= 20
    confidenceState := KR360_CONFIDENCE_AVOID
else if confidenceScore <= 40
    confidenceState := KR360_CONFIDENCE_LOW
else if confidenceScore <= 60
    confidenceState := KR360_CONFIDENCE_DEVELOPING
else if confidenceScore <= 80
    confidenceState := KR360_CONFIDENCE_HIGH
else
    confidenceState := KR360_CONFIDENCE_EXCEPTIONAL

string confidenceStateText = ""

switch confidenceState
    KR360_CONFIDENCE_EXCEPTIONAL => confidenceStateText := "Exceptional"
    KR360_CONFIDENCE_HIGH => confidenceStateText := "High Confidence"
    KR360_CONFIDENCE_DEVELOPING => confidenceStateText := "Developing"
    KR360_CONFIDENCE_LOW => confidenceStateText := "Low Confidence"
    => confidenceStateText := "Avoid"

string confidenceReason = ""

if confidenceNeutralTrend
    confidenceReason := "Neutral Trend"
else if confidenceRejectedAcceptance
    confidenceReason := "Rejected CPR"
else if confidenceHighRisk
    confidenceReason := "High Risk"
else if confidenceCompressionBuilding
    confidenceReason := "Building Compression"
else if confidenceWeakQuality
    confidenceReason := "Weak Quality"
else if confidenceExhaustedMomentum
    confidenceReason := "Exhausted Momentum"
else if confidenceLimitedOpportunity
    confidenceReason := "Limited Opportunity"
else if confidenceExpansionRelease
    confidenceReason := "Expansion Released"
else if confidenceHighOpportunity and confidenceStrongMomentum and confidenceLowRisk
    confidenceReason := "Aligned Opportunity"
else
    confidenceReason := "Aligned"

//==================================================================
// KR-360.70 PUBLIC INTERFACE
//==================================================================

bool outConfidenceReady = confidenceReady

int outConfidenceScore = confidenceScore
int outConfidenceState = confidenceState

string outConfidenceReason = confidenceReason

// Compatibility outputs retained for KR-705 and downstream consumers.
string outConfidenceText = confidenceStateText
string outConfidenceReasonText = confidenceReason

bool outConfidenceVeryHigh = confidenceState == KR360_CONFIDENCE_EXCEPTIONAL
bool outConfidenceHigh = confidenceState == KR360_CONFIDENCE_HIGH
bool outConfidenceMedium = confidenceState == KR360_CONFIDENCE_DEVELOPING
bool outConfidenceLow = confidenceState == KR360_CONFIDENCE_LOW
bool outConfidenceVeryLow = confidenceState == KR360_CONFIDENCE_AVOID

//==================================================================
// KR-360.80 PCA-006 EVIDENCE CONTRACT — PACKAGE A
//==================================================================

const string KR360_EVIDENCE_CONTRACT_IDENTITY = "KR-360 Evidence Contract"
const string KR360_EVIDENCE_CONTRACT_VERSION = PCA_CONTRACT_VERSION_1_0
const string KR360_EVIDENCE_CONTRACT_OWNER = "KR-360"
const string KR360_EVIDENCE_CONTRACT_PRODUCER = "KR-360"

string kr360StructureValue = outBullishStructure ? "BULLISH" : outBearishStructure ? "BEARISH" : "NEUTRAL"
string kr360ExtensionValue = outTrendQualityExtended ? "EXTENDED" : trendQualityInputReady ? "NOT EXTENDED" : PCA_INTEGRITY_NOT_EVALUATED
string kr360BoundaryValue = barstate.isconfirmed ? "COMPLETED" : "LIVE"
bool kr360StructureAvailable = not na(mdPrimaryTrendC)
bool kr360ReferenceAlignmentAvailable = outRelationshipReady
bool kr360PriceActionAvailable = outPriceActionReady
bool kr360LocationAvailable = outBarrierReady
bool kr360VolatilityAvailable = not na(indPrimaryTrendATR)
bool kr360AllMaterialEvidenceAvailable = outConsolidatedDirectionalReady and kr360StructureAvailable and outMomentumReady and outBarrierReady and outCompressionReady and outOpportunityInputReady and kr360ReferenceAlignmentAvailable and kr360PriceActionAvailable and trendQualityInputReady and kr360VolatilityAvailable
string kr360AggregateIntegrityStatus = kr360AllMaterialEvidenceAvailable ? PCA_INTEGRITY_VALID : PCA_INTEGRITY_DEGRADED
string kr360AggregateConflictSummary = outConsolidatedDirectionalConflict ? "DIRECTIONAL CONFLICT PRESERVED" : "NONE"

PCAEvidenceFieldRecord outKR360EvidenceTrend = pcaEvidenceField("Trend", outConsolidatedDirectionalText, "KR-341", outConsolidatedDirectionalSummary, outConsolidatedDirectionalReady, true, pcaObservationBoundary, pcaObservationTimestamp, outConsolidatedDirectionalConflict, "Trend evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceStructure = pcaEvidenceField("Structure", kr360StructureValue, "KR-275", str.tostring(outStructureState), kr360StructureAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Structure evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceMomentum = pcaEvidenceField("Momentum", outMomentumText, "KR-330", str.tostring(outMomentumScore), outMomentumReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Momentum evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceAcceptance = pcaEvidenceField("Acceptance", outAcceptanceText, "KR-320", str.tostring(outAcceptanceScore), outBarrierReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Acceptance evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceCompression = pcaEvidenceField("Compression", outCompressionText, "KR-315", str.tostring(outCompressionScore), outCompressionReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Compression evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceOpportunityContext = pcaEvidenceField("Opportunity Context", outOpportunityText, "KR-350", str.tostring(outOpportunityState), outOpportunityInputReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Opportunity context unavailable")
PCAEvidenceFieldRecord outKR360EvidenceReferenceAlignment = pcaEvidenceField("Reference Alignment", outRelationshipStatus, "KR-252", outRelationshipReason, kr360ReferenceAlignmentAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Reference alignment unavailable")
PCAEvidenceFieldRecord outKR360EvidencePriceAction = pcaEvidenceField("Price Action", outPriceActionSummary, "KR-335", str.tostring(outPriceActionScore), kr360PriceActionAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Price-action evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceLocation = pcaEvidenceField("Location", outPriceText, "KR-280", str.tostring(outPriceState), kr360LocationAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Location evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceExtension = pcaEvidenceField("Extension", kr360ExtensionValue, "KR-310", outTrendQualityText, trendQualityInputReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Extension evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceEntryObservation = pcaEvidenceField("Entry Observation", outPriceActionSummary, "KR-335", outPriceActionReason, kr360PriceActionAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Entry observation unavailable")
PCAEvidenceFieldRecord outKR360EvidenceDistanceFromReference = pcaEvidenceField("Distance from Reference", str.tostring(trendQualityDistanceFromSMA20), "KR-310", "Existing distance from SMA20", trendQualityInputReady and not na(trendQualityDistanceFromSMA20), true, pcaObservationBoundary, pcaObservationTimestamp, false, "Distance-from-reference evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceRemainingStructuralRoom = pcaEvidenceField("Remaining Structural Room", PCA_INTEGRITY_NOT_EVALUATED, "KR-360", "No approved existing public measurement", false, false, pcaObservationBoundary, pcaObservationTimestamp, false, "Not inferred in Package A")
PCAEvidenceFieldRecord outKR360EvidenceCompletedBoundaryStatus = pcaEvidenceField("Completed-Boundary Status", kr360BoundaryValue, "TradingView", str.tostring(time_close), true, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Boundary status unavailable")
PCAEvidenceFieldRecord outKR360EvidenceObservationBoundary = pcaEvidenceField("Observation Boundary", pcaObservationBoundary, "TradingView", timeframe.period, true, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Observation boundary unavailable")
PCAEvidenceFieldRecord outKR360EvidenceIntegrity = pcaEvidenceField("Evidence Integrity", kr360AggregateIntegrityStatus, "KR-360", kr360AggregateConflictSummary, true, true, pcaObservationBoundary, pcaObservationTimestamp, outConsolidatedDirectionalConflict, "Evidence integrity unavailable")
PCAEvidenceFieldRecord outKR360EvidenceVolatility = pcaEvidenceField("Volatility", str.tostring(indPrimaryTrendATR), "KR-270", "ATR(14)", kr360VolatilityAvailable, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Volatility evidence unavailable")
PCAEvidenceFieldRecord outKR360EvidenceQuality = pcaEvidenceField("Evidence Quality", outEvidenceText, "KR-310", str.tostring(outTrendQualityScore), outEvidenceReady, true, pcaObservationBoundary, pcaObservationTimestamp, false, "Evidence quality unavailable")

bool outKR360EvidenceContractVersionSupported = pcaVersionSupported(KR360_EVIDENCE_CONTRACT_VERSION, PCA_CONTRACT_VERSION_1_0)
bool outKR360EvidenceContractMandatoryFieldsPresent = pcaMandatoryStringPresent(KR360_EVIDENCE_CONTRACT_IDENTITY) and pcaMandatoryStringPresent(KR360_EVIDENCE_CONTRACT_OWNER) and pcaMandatoryStringPresent(pcaObservationBoundary) and pcaMandatoryStringPresent(outKR360EvidenceTrend.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceStructure.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceMomentum.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceAcceptance.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceCompression.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceOpportunityContext.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceReferenceAlignment.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidencePriceAction.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceLocation.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceExtension.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceEntryObservation.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceDistanceFromReference.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceRemainingStructuralRoom.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceCompletedBoundaryStatus.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceObservationBoundary.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceIntegrity.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceVolatility.fieldIdentity) and pcaMandatoryStringPresent(outKR360EvidenceQuality.fieldIdentity)
bool outKR360EvidenceContractSemanticCompatible = KR360_EVIDENCE_CONTRACT_OWNER == "KR-360" and KR360_EVIDENCE_CONTRACT_PRODUCER == "KR-360"
PCAIntegrityRecord outKR360EvidenceContractIntegrity = pcaContractIntegrity("KR-360", pcaObservationBoundary, pcaObservationTimestamp, outKR360EvidenceContractVersionSupported, outKR360EvidenceContractMandatoryFieldsPresent, outKR360EvidenceContractSemanticCompatible, kr360AggregateIntegrityStatus)
bool outKR360EvidenceContractValid = outKR360EvidenceContractVersionSupported and outKR360EvidenceContractMandatoryFieldsPresent and outKR360EvidenceContractSemanticCompatible
string outKR360EvidenceContractStatus = not outKR360EvidenceContractVersionSupported ? "UNSUPPORTED VERSION — FAIL CLOSED" : not outKR360EvidenceContractMandatoryFieldsPresent ? PCA_CONTRACT_INVALID : not outKR360EvidenceContractSemanticCompatible ? PCA_UPSTREAM_INCONSISTENT : outKR360EvidenceContractIntegrity.currentStatus

PCAKR360EvidenceContract outKR360EvidenceContract = PCAKR360EvidenceContract.new(contractIdentity = KR360_EVIDENCE_CONTRACT_IDENTITY, contractVersion = KR360_EVIDENCE_CONTRACT_VERSION, authoritativeOwner = KR360_EVIDENCE_CONTRACT_OWNER, producer = KR360_EVIDENCE_CONTRACT_PRODUCER, consumers = "KR-370 | KR-380A | KR-380", mandatoryInputs = "Approved Market Data | Approved Evidence Calculations | Observation Boundary | Source Provenance", optionalInputs = "NONE", mandatoryOutputs = "Trend | Structure | Momentum | Acceptance | Compression | Opportunity Context | Reference Alignment | Price Action | Location | Extension | Entry Observation | Distance from Reference | Remaining Structural Room | Completed-Boundary Status | Observation Boundary | Evidence Integrity | Volatility | Evidence Quality", integrityStates = "UNKNOWN | UNAVAILABLE | INVALID | STALE | NOT EVALUATED | DEGRADED", observationBoundary = pcaObservationBoundary, timestamp = pcaObservationTimestamp, failureBehavior = "Publish explicit integrity; never infer; preserve unavailable and conflict", compatibilityRule = "Unsupported version fails closed; missing field is INVALID CONTRACT; semantic mismatch is UPSTREAM INCONSISTENT", prohibitedAuthority = "Setup Validity | Setup Readiness | BUY READY | SELL READY | Canonical Pine State | Execution Authority", trend = outKR360EvidenceTrend, structure = outKR360EvidenceStructure, momentum = outKR360EvidenceMomentum, acceptance = outKR360EvidenceAcceptance, compression = outKR360EvidenceCompression, opportunityContext = outKR360EvidenceOpportunityContext, referenceAlignment = outKR360EvidenceReferenceAlignment, priceAction = outKR360EvidencePriceAction, location = outKR360EvidenceLocation, extension = outKR360EvidenceExtension, entryObservation = outKR360EvidenceEntryObservation, distanceFromReference = outKR360EvidenceDistanceFromReference, remainingStructuralRoom = outKR360EvidenceRemainingStructuralRoom, completedBoundaryStatus = outKR360EvidenceCompletedBoundaryStatus, observationBoundaryEvidence = outKR360EvidenceObservationBoundary, evidenceIntegrity = outKR360EvidenceIntegrity, volatility = outKR360EvidenceVolatility, evidenceQuality = outKR360EvidenceQuality, aggregateEvidenceIntegrity = outKR360EvidenceContractIntegrity, aggregateEvidenceConflictSummary = kr360AggregateConflictSummary)

//==================================================================
// END OF KR-360
//==================================================================



//==================================================================
// KR-370 : Setup Contract Producer / Legacy Decision Compatibility
// Version : 1.0.0
// Status  : FROZEN
// Last Updated : 2026-07-10
//
// Validation:
// - Copper
// - Silver
// - Gold
//
// Frozen Contract:
// - Uses only public outputs from prior KRONOS engines.
// - Owns directional setup and Acceptance-based setup validity.
// - Produces explainable setup and checklist outputs.
// - Does not own readiness or publish authoritative BUY/SELL READY.
// - No direct market calculations.
// - No alerts.
// - No entry triggers.
// - No trade-management logic.
//==================================================================

//==================================================================
// KR-370.10 DECISION STATE CONSTANTS
//==================================================================

const int KR370_DECISION_AVOID = 0
const int KR370_DECISION_WAIT = 1
const int KR370_DECISION_WATCH_LONG = 2
const int KR370_DECISION_WATCH_SHORT = 3
const int KR370_DECISION_BUY_READY = 4
const int KR370_DECISION_SELL_READY = 5

//==================================================================
// KR-370.20 INPUT READINESS
//==================================================================

bool decisionTrendReady = outConsolidatedDirectionalReady
bool decisionAcceptanceReady = outBarrierReady

// Package B: KR-370 owns setup formation only. Readiness-classified
// evidence remains observable here for compatibility, but cannot gate
// the KR-370 setup contract or create BUY READY / SELL READY authority.
bool decisionSetupInputsReady = decisionTrendReady and decisionAcceptanceReady
bool decisionReady = decisionSetupInputsReady

//==================================================================
// KR-370.30 PUBLIC CONDITION MAP
//==================================================================

bool decisionBullishTrend = decisionTrendReady and outConsolidatedBullishBias
bool decisionBearishTrend = decisionTrendReady and outConsolidatedBearishBias
bool decisionNeutralTrend = decisionTrendReady and outConsolidatedNeutralConflictedBias

bool decisionHigherTimeframeBullishBias = decisionBullishTrend
bool decisionHigherTimeframeBearishBias = decisionBearishTrend
bool decisionBullishContext = decisionHigherTimeframeBullishBias or outBullishContext
bool decisionBearishContext = decisionHigherTimeframeBearishBias or outBearishContext
bool decisionDirectionalContext = decisionBullishContext or decisionBearishContext

bool decisionAcceptanceConfirmed = decisionAcceptanceReady and (outAcceptanceAccepted or outAcceptanceStrong)
bool decisionAcceptanceRejected = decisionAcceptanceReady and outAcceptanceRejected

//==================================================================
// KR-370.40 DECISION CLASSIFICATION
//==================================================================

int decisionState = KR370_DECISION_WAIT
string decisionReason = ""
string decisionPrimaryBlocker = ""
string decisionNextReview = ""

if not decisionReady
    decisionState := KR370_DECISION_AVOID
    decisionReason := "Required setup evidence unavailable"
    decisionPrimaryBlocker := "Setup Evidence Unavailable"
    decisionNextReview := "After Setup Evidence Loads"
else if decisionAcceptanceRejected
    decisionState := KR370_DECISION_AVOID
    decisionReason := "Acceptance rejected; setup analytically blocked"
    decisionPrimaryBlocker := "Acceptance Rejected"
    decisionNextReview := "After Acceptance Reassessment"
else if decisionBullishTrend and decisionBullishContext
    decisionState := KR370_DECISION_WATCH_LONG
    if decisionAcceptanceConfirmed
        decisionReason := "Valid bullish setup; readiness owned by KR-380A"
        decisionPrimaryBlocker := "None"
        decisionNextReview := "KR-380A Readiness Assessment"
    else
        decisionReason := "Bullish setup forming; acceptance incomplete"
        decisionPrimaryBlocker := "Acceptance Pending"
        decisionNextReview := "After Acceptance Confirmation"
else if decisionBearishTrend and decisionBearishContext
    decisionState := KR370_DECISION_WATCH_SHORT
    if decisionAcceptanceConfirmed
        decisionReason := "Valid bearish setup; readiness owned by KR-380A"
        decisionPrimaryBlocker := "None"
        decisionNextReview := "KR-380A Readiness Assessment"
    else
        decisionReason := "Bearish setup forming; acceptance incomplete"
        decisionPrimaryBlocker := "Acceptance Pending"
        decisionNextReview := "After Acceptance Confirmation"
else if decisionNeutralTrend
    decisionState := KR370_DECISION_WAIT
    decisionReason := "Trend direction not established"
    decisionPrimaryBlocker := "Neutral Trend"
    decisionNextReview := "After Trend Confirmation"
else
    decisionState := KR370_DECISION_WAIT
    decisionReason := "Wait for directional setup confirmation"
    decisionPrimaryBlocker := "Directional Setup Pending"
    decisionNextReview := "After Direction Confirms"

string decisionText = ""

switch decisionState
    KR370_DECISION_AVOID => decisionText := "AVOID"
    KR370_DECISION_WAIT => decisionText := "WAIT"
    KR370_DECISION_WATCH_LONG => decisionText := "WATCH LONG"
    KR370_DECISION_WATCH_SHORT => decisionText := "WATCH SHORT"
    KR370_DECISION_BUY_READY => decisionText := "BUY READY"
    KR370_DECISION_SELL_READY => decisionText := "SELL READY"

//==================================================================
// KR-370.50 DYNAMIC NEED CHECKLIST
//==================================================================

string decisionNeed1 = ""
string decisionNeed2 = ""
string decisionNeed3 = ""
int decisionNeedCount = 0

if not decisionDirectionalContext and decisionNeedCount < 3
    decisionNeedCount += 1
    if decisionNeedCount == 1
        decisionNeed1 := "☐ Trend Confirmation"
    else if decisionNeedCount == 2
        decisionNeed2 := "☐ Trend Confirmation"
    else
        decisionNeed3 := "☐ Trend Confirmation"

if not decisionAcceptanceConfirmed and decisionNeedCount < 3
    decisionNeedCount += 1
    if decisionNeedCount == 1
        decisionNeed1 := "☐ Higher-Timeframe Acceptance Pending"
    else if decisionNeedCount == 2
        decisionNeed2 := "☐ Higher-Timeframe Acceptance Pending"
    else
        decisionNeed3 := "☐ Higher-Timeframe Acceptance Pending"

if (decisionState == KR370_DECISION_WATCH_LONG or decisionState == KR370_DECISION_WATCH_SHORT) and decisionAcceptanceConfirmed and decisionNeedCount < 3
    decisionNeedCount += 1
    if decisionNeedCount == 1
        decisionNeed1 := "✓ Trend Aligned"
    else if decisionNeedCount == 2
        decisionNeed2 := "✓ Trend Aligned"
    else
        decisionNeed3 := "✓ Trend Aligned"

if (decisionState == KR370_DECISION_WATCH_LONG or decisionState == KR370_DECISION_WATCH_SHORT) and decisionAcceptanceConfirmed and decisionNeedCount < 3
    decisionNeedCount += 1
    if decisionNeedCount == 1
        decisionNeed1 := "✓ Acceptance Confirmed"
    else if decisionNeedCount == 2
        decisionNeed2 := "✓ Acceptance Confirmed"
    else
        decisionNeed3 := "✓ Acceptance Confirmed"

//==================================================================
// KR-370.60 PUBLIC INTERFACE
//==================================================================

bool outDecisionReady = decisionReady

int outDecisionState = decisionState

string outDecisionText = decisionText
string outDecisionReason = decisionReason
string outPrimaryBlocker = decisionPrimaryBlocker
string outNextReview = decisionNextReview
string outNeed1 = decisionNeed1
string outNeed2 = decisionNeed2
string outNeed3 = decisionNeed3

bool outDecisionAvoid = decisionState == KR370_DECISION_AVOID
bool outDecisionWait = decisionState == KR370_DECISION_WAIT
bool outDecisionWatchLong = decisionState == KR370_DECISION_WATCH_LONG
bool outDecisionWatchShort = decisionState == KR370_DECISION_WATCH_SHORT
// Retained compatibility fields are deliberately non-authoritative in
// Package B. KR-380A is the sole readiness owner.
bool outDecisionBuyReady = false
bool outDecisionSellReady = false

//==================================================================
// KR-370.70 PCA-006 SETUP CONTRACT — PACKAGE B AUTHORITY
//==================================================================

const string KR370_SETUP_CONTRACT_IDENTITY = "KR-370 Setup Contract"
const string KR370_SETUP_CONTRACT_VERSION = PCA_CONTRACT_VERSION_1_0
const string KR370_SETUP_CONTRACT_OWNER = "KR-370"
const string KR370_SETUP_CONTRACT_PRODUCER = "KR-370"

bool kr370EvidenceVersionCompatible = outKR360EvidenceContract.contractVersion == PCA_CONTRACT_VERSION_1_0
bool kr370EvidenceIdentityCompatible = outKR360EvidenceContract.contractIdentity == KR360_EVIDENCE_CONTRACT_IDENTITY
bool kr370EvidenceBoundaryCompatible = outKR360EvidenceContract.observationBoundary == pcaObservationBoundary
bool kr370EvidenceSemanticCompatible = kr370EvidenceIdentityCompatible and kr370EvidenceBoundaryCompatible and outKR360EvidenceContract.authoritativeOwner == "KR-360" and outKR360EvidenceContract.producer == "KR-360"
bool kr370EvidenceContractConsumable = kr370EvidenceVersionCompatible and outKR360EvidenceContractValid and kr370EvidenceSemanticCompatible

bool kr370LongDirectionalSetup = decisionBullishTrend and decisionBullishContext and not decisionBearishTrend
bool kr370ShortDirectionalSetup = decisionBearishTrend and decisionBearishContext and not decisionBullishTrend
bool kr370DirectionalSetup = kr370LongDirectionalSetup or kr370ShortDirectionalSetup
bool kr370AcceptanceValid = decisionAcceptanceConfirmed
bool kr370AcceptanceBlocked = decisionAcceptanceRejected
bool kr370SetupValid = kr370EvidenceContractConsumable and kr370DirectionalSetup and kr370AcceptanceValid and not outConsolidatedDirectionalConflict
string kr370SetupDirection = outConsolidatedDirectionalConflict ? "CONFLICTED" : kr370LongDirectionalSetup ? "LONG" : kr370ShortDirectionalSetup ? "SHORT" : outConsolidatedDirectionalNeutral ? "NON-DIRECTIONAL" : outConsolidatedDirectionalReady ? "NONE" : "UNKNOWN"
string kr370SetupState = not kr370EvidenceVersionCompatible ? "SETUP ASSESSMENT UNAVAILABLE" : not outKR360EvidenceContractMandatoryFieldsPresent ? "SETUP ASSESSMENT UNAVAILABLE" : not kr370EvidenceSemanticCompatible ? "SETUP ASSESSMENT DEGRADED" : outConsolidatedDirectionalConflict ? "DIRECTIONALLY CONFLICTED" : kr370AcceptanceBlocked ? "SETUP ANALYTICALLY BLOCKED" : kr370SetupValid ? "SETUP VALID" : kr370LongDirectionalSetup ? "WATCH LONG" : kr370ShortDirectionalSetup ? "WATCH SHORT" : "NO SETUP"
string kr370SetupValidity = not kr370EvidenceContractConsumable ? (outKR360EvidenceContractIntegrity.currentStatus == PCA_INTEGRITY_UNAVAILABLE ? "UNAVAILABLE" : outKR360EvidenceContractIntegrity.currentStatus == PCA_INTEGRITY_INVALID ? "INVALID" : "DEGRADED") : kr370AcceptanceBlocked ? "INVALID" : kr370SetupValid ? "VALID" : kr370DirectionalSetup or outConsolidatedDirectionalConflict ? "INCOMPLETE" : "UNKNOWN"
string kr370SetupMaturity = kr370SetupValid ? "ESTABLISHED" : kr370DirectionalSetup ? "FORMING" : "ABSENT"
string kr370SetupQuality = outEvidenceReady ? outEvidenceText : PCA_INTEGRITY_UNAVAILABLE
string kr370ReadinessEligibility = kr370EvidenceContractConsumable and kr370SetupValidity == "VALID" ? "ELIGIBLE" : not kr370EvidenceContractConsumable ? "UNAVAILABLE" : "INELIGIBLE"
string kr370SetupIdentity = kr370SetupDirection == "LONG" ? "KRONOS SWING LONG SETUP" : kr370SetupDirection == "SHORT" ? "KRONOS SWING SHORT SETUP" : kr370SetupDirection == "CONFLICTED" ? "KRONOS SWING CONFLICTED SETUP" : "KRONOS SWING SETUP"
string kr370SupportingEvidenceReferences = "KR-360:Trend | KR-360:Structure | KR-360:Acceptance"
string kr370ContradictoryEvidenceReferences = outConsolidatedDirectionalConflict ? "KR-360:Trend — DIRECTIONAL CONFLICT" : kr370AcceptanceBlocked ? "KR-360:Acceptance — REJECTED" : "NONE"
string kr370MissingMandatoryEvidence = not decisionTrendReady ? "KR-360:Trend" : not decisionAcceptanceReady ? "KR-360:Acceptance" : "NONE"
string kr370InvalidUnavailableEvidence = not kr370EvidenceContractConsumable ? outKR360EvidenceContractStatus : "NONE"
string kr370GoverningSetupRule = PCA_PACKAGE_B_POLICY_IDENTITY + " — Trend/directional context and Acceptance setup policy"
string kr370AnalyticalBlockerIdentity = kr370AcceptanceBlocked ? "Acceptance Rejected" : outConsolidatedDirectionalConflict ? "Directional Conflict" : "NONE"
string kr370AnalyticalBlockerStatus = kr370AnalyticalBlockerIdentity == "NONE" ? "INACTIVE" : "ACTIVE"
string kr370AnalyticalNextEvent = kr370AcceptanceBlocked ? "Acceptance is reassessed by KR-360 evidence" : outConsolidatedDirectionalConflict ? "Directional conflict resolves in KR-360 evidence" : "NONE"
PCABlockerRecord outKR370PrimaryAnalyticalBlocker = PCABlockerRecord.new(kr370AnalyticalBlockerIdentity, "ANALYTICAL", "KR-370", kr370GoverningSetupRule, kr370AnalyticalBlockerStatus, kr370ContradictoryEvidenceReferences, pcaObservationBoundary, pcaObservationTimestamp, kr370AnalyticalNextEvent)
PCALifecycleEvaluation kr370Lifecycle = pcaPackageCSetupLifecycle(kr370SetupIdentity, kr370SetupState, kr370SetupMaturity, kr370AnalyticalBlockerIdentity)
PCATransitionRecord outKR370SetupTransition = PCATransitionRecord.new(kr370Lifecycle.priorState, kr370SetupState, kr370Lifecycle.transitionCause, kr370Lifecycle.appliedRule, pcaObservationBoundary, pcaObservationTimestamp, kr370Lifecycle.assessmentStatus)

bool outKR370SetupContractVersionSupported = pcaVersionSupported(KR370_SETUP_CONTRACT_VERSION, PCA_CONTRACT_VERSION_1_0)
bool outKR370SetupContractMandatoryFieldsPresent = pcaMandatoryStringPresent(KR370_SETUP_CONTRACT_IDENTITY) and pcaMandatoryStringPresent(kr370SetupIdentity) and pcaMandatoryStringPresent(kr370SetupDirection) and pcaMandatoryStringPresent(kr370SetupState) and pcaMandatoryStringPresent(kr370SetupValidity) and pcaMandatoryStringPresent(kr370SetupMaturity) and pcaMandatoryStringPresent(kr370SetupQuality) and pcaMandatoryStringPresent(kr370ReadinessEligibility) and pcaMandatoryStringPresent(kr370GoverningSetupRule) and pcaMandatoryStringPresent(pcaObservationBoundary)
bool outKR370SetupContractSemanticCompatible = kr370EvidenceSemanticCompatible and KR370_SETUP_CONTRACT_OWNER == "KR-370" and KR370_SETUP_CONTRACT_PRODUCER == "KR-370"
string kr370SetupIntegrityStatus = not kr370EvidenceContractConsumable ? (not kr370EvidenceVersionCompatible or not outKR360EvidenceContractMandatoryFieldsPresent ? PCA_INTEGRITY_INVALID : PCA_INTEGRITY_DEGRADED) : not decisionTrendReady or not decisionAcceptanceReady ? PCA_INTEGRITY_UNAVAILABLE : PCA_INTEGRITY_VALID
PCAIntegrityRecord outKR370SetupContractIntegrity = pcaContractIntegrity("KR-370", pcaObservationBoundary, pcaObservationTimestamp, outKR370SetupContractVersionSupported and kr370EvidenceVersionCompatible, outKR370SetupContractMandatoryFieldsPresent and outKR360EvidenceContractMandatoryFieldsPresent, outKR370SetupContractSemanticCompatible, kr370SetupIntegrityStatus)
bool outKR370SetupContractValid = outKR370SetupContractVersionSupported and outKR370SetupContractMandatoryFieldsPresent and outKR370SetupContractSemanticCompatible and kr370EvidenceContractConsumable
string outKR370SetupContractStatus = not outKR370SetupContractVersionSupported or not kr370EvidenceVersionCompatible ? "UNSUPPORTED VERSION — FAIL CLOSED" : not outKR370SetupContractMandatoryFieldsPresent or not outKR360EvidenceContractMandatoryFieldsPresent ? PCA_CONTRACT_INVALID : not outKR370SetupContractSemanticCompatible ? PCA_UPSTREAM_INCONSISTENT : outKR370SetupContractIntegrity.currentStatus

PCAKR370SetupContract outKR370SetupContract = PCAKR370SetupContract.new(contractIdentity = KR370_SETUP_CONTRACT_IDENTITY, contractVersion = KR370_SETUP_CONTRACT_VERSION, authoritativeOwner = KR370_SETUP_CONTRACT_OWNER, producer = KR370_SETUP_CONTRACT_PRODUCER, consumers = "KR-380A | KR-380", mandatoryInputs = "Published KR-360 Evidence | KR-360 Integrity Records | Observation Boundary", optionalInputs = "Confidence Summary — explanation only", mandatoryOutputs = "Setup Identity | Setup Family | Setup Direction | Setup State | Setup Validity | Setup Maturity | Setup Quality | Readiness Eligibility | Evidence References | Primary Analytical Blocker | Lifecycle and Transition schema", integrityStates = "UNKNOWN | UNAVAILABLE | INVALID | STALE | NOT EVALUATED | DEGRADED", observationBoundary = pcaObservationBoundary, timestamp = pcaObservationTimestamp, failureBehavior = "Publish explicit setup integrity; never infer readiness; preserve conflict", compatibilityRule = "Unsupported version fails closed; missing field is INVALID CONTRACT; semantic mismatch is UPSTREAM INCONSISTENT", prohibitedAuthority = "Readiness Qualified | BUY READY | SELL READY | LONG ACTION CONFIRMED | SHORT ACTION CONFIRMED | Execution Authority", setupIdentity = kr370SetupIdentity, setupFamily = "KRONOS SWING", setupDirection = kr370SetupDirection, setupState = kr370SetupState, setupValidity = kr370SetupValidity, setupMaturity = kr370SetupMaturity, setupQuality = kr370SetupQuality, readinessEligibility = kr370ReadinessEligibility, supportingEvidenceReferences = kr370SupportingEvidenceReferences, contradictoryEvidenceReferences = kr370ContradictoryEvidenceReferences, missingMandatoryEvidence = kr370MissingMandatoryEvidence, invalidOrUnavailableEvidence = kr370InvalidUnavailableEvidence, governingSetupRule = kr370GoverningSetupRule, primaryAnalyticalBlocker = outKR370PrimaryAnalyticalBlocker, lifecycleStatus = kr370Lifecycle.lifecycleStatus, persistenceStatus = kr370Lifecycle.persistenceStatus, resetStatusAndCause = kr370Lifecycle.resetStatusAndCause, expiryStatusAndCause = kr370Lifecycle.expiryStatusAndCause, priorSetupIdentity = kr370Lifecycle.priorIdentity, priorSetupState = kr370Lifecycle.priorState, transitionRule = kr370Lifecycle.appliedRule, transitionRecord = outKR370SetupTransition, integrity = outKR370SetupContractIntegrity)

//==================================================================
// END OF KR-370
//==================================================================



//==================================================================
// KR-380A : Readiness Contract Producer / Legacy Execution Context Compatibility
// Version : 1.0.0
// Status  : FROZEN
// Last Updated : 2026-07-10
//
// Purpose:
// Provides the formal execution-context interface consumed by KR-380.
// This adapter is the approved exception that may read KR-260/KR-270
// reference datasets for timing context. KR-380 classification must
// consume these public adapter outputs instead of scattered raw
// reference variables.
//
// Validation Scope:
// - MCX self-contained execution support validated on Copper, Gold,
//   and Silver as part of the KR-380 timing freeze.
//
// Frozen Contract:
// - KR-380A is the sole readiness owner under Package B V1.
// - Approved narrow adapter exception for readiness context.
// - Does not duplicate KR-300 through KR-370 intelligence.
// - Exposes only the minimum facts required by KR-380 timing.
// - Produces no alerts, orders, stops, targets, plots or labels.
//==================================================================

const int ECPC_CONTEXT_OUTCOME_NONE = 0
const int ECPC_CONTEXT_OUTCOME_PENDING = 1
const int ECPC_CONTEXT_OUTCOME_QUALIFIED = 2
const int ECPC_CONTEXT_OUTCOME_EXTENDED = 3
const int ECPC_CONTEXT_OUTCOME_FAILED = 4

const int ECPC_CONTEXT_BLOCKER_NONE = 0
const int ECPC_CONTEXT_BLOCKER_DATA_PENDING = 1
const int ECPC_CONTEXT_BLOCKER_CONTEXT_PENDING = 2
const int ECPC_CONTEXT_BLOCKER_DIRECTIONAL_ALIGNMENT = 3
const int ECPC_CONTEXT_BLOCKER_PRICE_ACCEPTANCE = 4
const int ECPC_CONTEXT_BLOCKER_EXPANSION = 5
const int ECPC_CONTEXT_BLOCKER_MOMENTUM = 6
const int ECPC_CONTEXT_BLOCKER_REVIEW_BARRIER_VETO = 7
const int ECPC_CONTEXT_BLOCKER_OPPORTUNITY = 8
const int ECPC_CONTEXT_BLOCKER_EXECUTION_CONFIRMATION = 9
const int ECPC_CONTEXT_BLOCKER_PRICE_EXTENDED = 10
const int ECPC_CONTEXT_BLOCKER_SETUP_FAILED = 11

bool execContextMCXChart = assetMarket == "MCX"
bool execContextMCX1HChart = execContextMCXChart and timeframe.isintraday and timeframe.multiplier == 60
bool execContextLongIntent = outKR370SetupContract.setupDirection == "LONG"
bool execContextShortIntent = outKR370SetupContract.setupDirection == "SHORT"
bool execContextDirectionalIntent = execContextLongIntent or execContextShortIntent
bool execContextReadySetup = outKR370SetupContract.setupValidity == "VALID" and outKR370SetupContract.readinessEligibility == "ELIGIBLE" and execContextDirectionalIntent

bool execContextDecisionReady = outKR370SetupContractValid
bool execContextCompressionReady = outCompressionReady
bool execContextMomentumInputReady = outMomentumReady
bool execContextOpportunityReady = outOpportunityInputReady
bool execContextBaseReady = execContextDecisionReady and outKR360EvidenceContractValid and execContextOpportunityReady

float execContextRef4HRange = mdReferenceStructureH - mdReferenceStructureL
float execContextRef4HPrevRange = mdReferenceStructureH[1] - mdReferenceStructureL[1]

bool execContextRefDailyDataReady = not na(mdReferenceTrendC) and not na(indReferenceTrendSMA50)
bool execContextRef4HDataReady = not na(mdReferenceStructureC) and not na(mdReferenceStructureH[1]) and not na(mdReferenceStructureL[1]) and not na(execContextRef4HRange) and not na(execContextRef4HPrevRange)
bool execContextRef1HDataReady = not na(mdReferenceExecutionC) and not na(mdReferenceExecutionC[1])

bool execContextRefDailyBullishPermission = execContextRefDailyDataReady and mdReferenceTrendC > indReferenceTrendSMA50
bool execContextRefDailyBearishPermission = execContextRefDailyDataReady and mdReferenceTrendC < indReferenceTrendSMA50

bool execContextRef4HCompressionReady = execContextRef4HDataReady and execContextRef4HRange > execContextRef4HPrevRange * 0.80
bool execContextRef4HBullishPermission = execContextRef4HDataReady and mdReferenceStructureC > mdReferenceStructureH[1]
bool execContextRef4HBearishPermission = execContextRef4HDataReady and mdReferenceStructureC < mdReferenceStructureL[1]
bool execContextRef4HAcceptanceReady = execContextRef4HCompressionReady and ((execContextLongIntent and execContextRef4HBullishPermission) or (execContextShortIntent and execContextRef4HBearishPermission))

bool execContextRef1HBullishSupport = execContextRef1HDataReady and mdReferenceExecutionC >= mdReferenceExecutionC[1]
bool execContextRef1HBearishSupport = execContextRef1HDataReady and mdReferenceExecutionC <= mdReferenceExecutionC[1]
bool execContextRef1HMomentumReady = (execContextLongIntent and execContextRef1HBullishSupport) or (execContextShortIntent and execContextRef1HBearishSupport)

bool execContextCompressionBlocking = execContextCompressionReady and not outExpansionStarted and (outCompressionBuilding or outCompressionStrong or outCompressionCritical)
bool execContextMomentumOptionalSupport = execContextMomentumInputReady and (outMomentumStrong or outMomentumBuilding)
bool execContextMomentumReducing = execContextMomentumInputReady and (outMomentumExhausted or outMomentumWeakening)
bool execContextOpportunityPresent = execContextOpportunityReady and ((execContextLongIntent and outBullishOpportunityContext) or (execContextShortIntent and outBearishOpportunityContext))
bool execContextOpportunityMissing = execContextOpportunityReady and not execContextOpportunityPresent
bool execContextCompletedBoundary = barstate.isconfirmed
bool execContextReviewInputReady = outReviewInputReady
bool execContextReviewReady = execContextReviewInputReady and outReviewReady
bool execContextReviewBlocked = execContextReviewInputReady and outReviewBlocked
bool execContextExplicitVeto = execContextReviewBlocked
bool execContextDailyReferenceOpposes = execContextRefDailyDataReady and ((execContextLongIntent and not execContextRefDailyBullishPermission) or (execContextShortIntent and not execContextRefDailyBearishPermission))
bool execContextLocalExecutionReady = execContextMCX1HChart and execContextCompletedBoundary and execContextOpportunityPresent and not execContextExplicitVeto

// Package B: reference confirmation, Momentum, Compression, Review context,
// Extension, Quality, and Confidence are not universal readiness gates.
// Missing optional/reducing evidence remains disclosed but cannot make the
// readiness contract unavailable.
bool execContextDataReady = execContextBaseReady
bool execContextAvailable = execContextMCX1HChart and execContextDataReady
bool execContextExtended = execContextAvailable and execContextReadySetup and outTrendQualityExtended
bool execContextFailed = execContextAvailable and execContextReadySetup and execContextExplicitVeto
bool execContextQualified = execContextAvailable and execContextReadySetup and execContextLocalExecutionReady

int execContextOutcome = ECPC_CONTEXT_OUTCOME_NONE

if execContextAvailable
    if execContextFailed
        execContextOutcome := ECPC_CONTEXT_OUTCOME_FAILED
    else if execContextQualified
        execContextOutcome := ECPC_CONTEXT_OUTCOME_QUALIFIED
    else
        execContextOutcome := ECPC_CONTEXT_OUTCOME_PENDING

int execContextBlocker1 = ECPC_CONTEXT_BLOCKER_NONE
int execContextBlocker2 = ECPC_CONTEXT_BLOCKER_NONE
int execContextBlocker3 = ECPC_CONTEXT_BLOCKER_NONE
int execContextBlockerCount = 0
int execContextBlockerCandidate = ECPC_CONTEXT_BLOCKER_NONE

if not execContextAvailable
    execContextBlockerCandidate := execContextMCX1HChart ? ECPC_CONTEXT_BLOCKER_DATA_PENDING : ECPC_CONTEXT_BLOCKER_CONTEXT_PENDING
    execContextBlockerCount += 1
    execContextBlocker1 := execContextBlockerCandidate

if execContextAvailable and execContextOutcome == ECPC_CONTEXT_OUTCOME_FAILED
    execContextBlockerCount += 1
    execContextBlocker1 := ECPC_CONTEXT_BLOCKER_REVIEW_BARRIER_VETO

if execContextAvailable and execContextOutcome == ECPC_CONTEXT_OUTCOME_PENDING
    if not execContextDirectionalIntent and execContextBlockerCount < 3
        execContextBlockerCandidate := ECPC_CONTEXT_BLOCKER_DIRECTIONAL_ALIGNMENT
        if execContextBlockerCandidate != execContextBlocker1 and execContextBlockerCandidate != execContextBlocker2 and execContextBlockerCandidate != execContextBlocker3
            execContextBlockerCount += 1
            if execContextBlockerCount == 1
                execContextBlocker1 := execContextBlockerCandidate
            else if execContextBlockerCount == 2
                execContextBlocker2 := execContextBlockerCandidate
            else
                execContextBlocker3 := execContextBlockerCandidate

    if not execContextOpportunityPresent and execContextBlockerCount < 3
        execContextBlockerCandidate := ECPC_CONTEXT_BLOCKER_OPPORTUNITY
        if execContextBlockerCandidate != execContextBlocker1 and execContextBlockerCandidate != execContextBlocker2 and execContextBlockerCandidate != execContextBlocker3
            execContextBlockerCount += 1
            if execContextBlockerCount == 1
                execContextBlocker1 := execContextBlockerCandidate
            else if execContextBlockerCount == 2
                execContextBlocker2 := execContextBlockerCandidate
            else
                execContextBlocker3 := execContextBlockerCandidate

    if execContextOpportunityPresent and not execContextCompletedBoundary and execContextBlockerCount < 3
        execContextBlocker1 := ECPC_CONTEXT_BLOCKER_EXECUTION_CONFIRMATION

string outExecContextVersion = "2.0"
bool outExecContextAvailable = execContextAvailable
int outExecContextOutcome = execContextOutcome
int outExecContextBlocker1 = execContextBlocker1
int outExecContextBlocker2 = execContextBlocker2
int outExecContextBlocker3 = execContextBlocker3

//==================================================================
// KR-380A.90 PCA-006 READINESS CONTRACT — PACKAGE B V1
//==================================================================

const string KR380A_READINESS_CONTRACT_IDENTITY = "KR-380A Readiness Contract"
const string KR380A_READINESS_CONTRACT_VERSION = PCA_CONTRACT_VERSION_1_0
const string KR380A_READINESS_CONTRACT_OWNER = "KR-380A"
const string KR380A_READINESS_CONTRACT_PRODUCER = "KR-380A"
const string KR380A_READINESS_POLICY_IDENTITY = PCA_PACKAGE_B_POLICY_IDENTITY
const string KR380A_READINESS_POLICY_VERSION = PCA_PACKAGE_B_POLICY_VERSION

pcaReadinessBlockerIdentity(int blocker) =>
    string identity = "NONE"
    switch blocker
        ECPC_CONTEXT_BLOCKER_DATA_PENDING => identity := "Data Pending"
        ECPC_CONTEXT_BLOCKER_CONTEXT_PENDING => identity := "Context Pending"
        ECPC_CONTEXT_BLOCKER_DIRECTIONAL_ALIGNMENT => identity := "Directional Alignment Pending"
        ECPC_CONTEXT_BLOCKER_PRICE_ACCEPTANCE => identity := "Price Acceptance Pending"
        ECPC_CONTEXT_BLOCKER_EXPANSION => identity := "Expansion Pending"
        ECPC_CONTEXT_BLOCKER_MOMENTUM => identity := "Momentum Pending"
        ECPC_CONTEXT_BLOCKER_REVIEW_BARRIER_VETO => identity := "Review Barrier Veto"
        ECPC_CONTEXT_BLOCKER_OPPORTUNITY => identity := "Opportunity Pending"
        ECPC_CONTEXT_BLOCKER_EXECUTION_CONFIRMATION => identity := "Confirmation Pending"
        ECPC_CONTEXT_BLOCKER_PRICE_EXTENDED => identity := "Price Extended"
        ECPC_CONTEXT_BLOCKER_SETUP_FAILED => identity := "Legacy Context Setup Failure"
    identity

bool kr380ASetupVersionCompatible = outKR370SetupContract.contractVersion == PCA_CONTRACT_VERSION_1_0
bool kr380ASetupIdentityCompatible = outKR370SetupContract.contractIdentity == KR370_SETUP_CONTRACT_IDENTITY
bool kr380ASetupBoundaryCompatible = outKR370SetupContract.observationBoundary == pcaObservationBoundary
bool kr380ALegacyContextVersionCompatible = outExecContextVersion == "2.0"
bool kr380ASetupSemanticCompatible = kr380ASetupIdentityCompatible and kr380ASetupBoundaryCompatible and outKR370SetupContract.authoritativeOwner == "KR-370" and outKR370SetupContract.producer == "KR-370"
bool kr380ASetupContractConsumable = kr380ASetupVersionCompatible and outKR370SetupContractValid and kr380ASetupSemanticCompatible
string kr380AReadinessState = pcaPackageBReadinessState(kr380ASetupVersionCompatible, kr380ALegacyContextVersionCompatible, outKR370SetupContractMandatoryFieldsPresent, kr380ASetupSemanticCompatible, outKR370SetupContract.readinessEligibility, outExecContextAvailable, outExecContextOutcome == ECPC_CONTEXT_OUTCOME_FAILED, outExecContextOutcome == ECPC_CONTEXT_OUTCOME_QUALIFIED, outExecContextOutcome == ECPC_CONTEXT_OUTCOME_PENDING, execContextReadySetup, execContextOpportunityMissing)
string kr380ATimingState = kr380AReadinessState == "QUALIFIED" ? "TIMELY" : execContextReadySetup and execContextOpportunityPresent and not execContextCompletedBoundary ? "TOO EARLY" : "TIMING UNKNOWN"
string kr380AExtensionState = outExecContextAvailable and execContextExtended ? "EXTENDED" : outExecContextAvailable ? "NOT EXTENDED" : "EXTENSION UNKNOWN"
string kr380APrimaryBlockerIdentity = pcaPackageBPrimaryBlocker(kr380ASetupContractConsumable, outKR370SetupContractStatus, kr380ALegacyContextVersionCompatible, outKR370SetupContract.readinessEligibility, pcaReadinessBlockerIdentity(outExecContextBlocker1))
string kr380APrimaryBlockerStatus = kr380APrimaryBlockerIdentity == "NONE" ? "INACTIVE" : "ACTIVE"
string kr380ANextRequiredEvent = pcaPackageBNextRequiredEvent(kr380APrimaryBlockerIdentity)
string kr380AMandatoryResult = execContextReadySetup and execContextOpportunityPresent and execContextCompletedBoundary ? "SATISFIED" : "UNSATISFIED"
string kr380AOptionalSupportResult = pcaPackageBOptionalSupportSummary(execContextMomentumOptionalSupport, execContextCompressionReady and outExpansionStarted, execContextRef4HCompressionReady, execContextRef4HAcceptanceReady, execContextRef1HMomentumReady)
string kr380AReductionResult = pcaPackageBReductionSummary(execContextCompressionBlocking, execContextMomentumReducing, execContextDailyReferenceOpposes, execContextRefDailyDataReady, execContextReviewInputReady and not execContextReviewReady and not execContextReviewBlocked, execContextExtended)
string kr380AVetoResult = execContextExplicitVeto ? "ACTIVE — Review Barrier Veto" : "INACTIVE"
PCABlockerRecord outKR380APrimaryReadinessBlocker = PCABlockerRecord.new(kr380APrimaryBlockerIdentity, "READINESS", "KR-380A", PCA_PACKAGE_B_POLICY_IDENTITY, kr380APrimaryBlockerStatus, "KR-370 Setup Contract | KR-360 Evidence Contract | KR-380A V1 condition evaluations", pcaObservationBoundary, pcaObservationTimestamp, kr380ANextRequiredEvent)
PCAConditionEvaluationRecord outKR380AMandatoryConditionEvaluations = PCAConditionEvaluationRecord.new("Valid directional setup | Direction-aligned Opportunity | Completed MCX 1H context", outKR370SetupContract.setupFamily, PCA_CONDITION_MANDATORY, kr380AMandatoryResult, "KR-370 Setup Contract | KR-360 Opportunity Context | TradingView completed boundary", "KR-380A", pcaObservationBoundary, pcaObservationTimestamp, outKR370SetupContractIntegrity.currentStatus, PCA_PACKAGE_B_POLICY_IDENTITY)
PCAConditionEvaluationRecord outKR380AOptionalSupportEvaluations = PCAConditionEvaluationRecord.new("Momentum strength | Expansion release | COMEX 4H range | COMEX 4H acceptance | COMEX 1H momentum", outKR370SetupContract.setupFamily, PCA_CONDITION_OPTIONAL_SUPPORT, kr380AOptionalSupportResult, "Existing KR-330/KR-315 and COMEX calculations", "KR-380A", pcaObservationBoundary, pcaObservationTimestamp, PCA_INTEGRITY_VALID, PCA_PACKAGE_B_POLICY_IDENTITY)
PCAConditionEvaluationRecord outKR380AReadinessReductionEvaluations = PCAConditionEvaluationRecord.new("Weak Momentum | Compression | Daily reference opposition | Review context | Extension", outKR370SetupContract.setupFamily, PCA_CONDITION_READINESS_REDUCING, kr380AReductionResult, "Existing KR-330/KR-315/KR-340/KR-310 and COMEX calculations", "KR-380A", pcaObservationBoundary, pcaObservationTimestamp, PCA_INTEGRITY_VALID, PCA_PACKAGE_B_POLICY_IDENTITY)
PCAConditionEvaluationRecord outKR380AExplicitVetoEvaluations = PCAConditionEvaluationRecord.new("Review Barrier Veto", outKR370SetupContract.setupFamily, PCA_CONDITION_EXPLICIT_VETO, kr380AVetoResult, "KR-340 underlying barrier interaction", "KR-380A", pcaObservationBoundary, pcaObservationTimestamp, PCA_INTEGRITY_VALID, PCA_PACKAGE_B_POLICY_IDENTITY)
PCALifecycleEvaluation kr380AReadinessLifecycle = pcaPackageCReadinessLifecycle(outKR370SetupContract.setupIdentity, kr380AReadinessState, kr380APrimaryBlockerIdentity)
PCATransitionRecord outKR380AReadinessTransition = PCATransitionRecord.new(kr380AReadinessLifecycle.priorState, kr380AReadinessState, kr380AReadinessLifecycle.transitionCause, kr380AReadinessLifecycle.appliedRule, pcaObservationBoundary, pcaObservationTimestamp, kr380AReadinessLifecycle.assessmentStatus)

bool outKR380AReadinessContractVersionSupported = pcaVersionSupported(KR380A_READINESS_CONTRACT_VERSION, PCA_CONTRACT_VERSION_1_0)
bool outKR380AReadinessContractMandatoryFieldsPresent = pcaMandatoryStringPresent(KR380A_READINESS_CONTRACT_IDENTITY) and pcaMandatoryStringPresent(KR380A_READINESS_POLICY_IDENTITY) and pcaMandatoryStringPresent(outKR370SetupContract.setupIdentity) and pcaMandatoryStringPresent(outKR370SetupContract.setupValidity) and pcaMandatoryStringPresent(outKR370SetupContract.readinessEligibility) and pcaMandatoryStringPresent(kr380AReadinessState) and pcaMandatoryStringPresent(kr380ATimingState) and pcaMandatoryStringPresent(kr380AExtensionState) and pcaMandatoryStringPresent(pcaObservationBoundary)
bool outKR380AReadinessContractSemanticCompatible = kr380ASetupSemanticCompatible and KR380A_READINESS_CONTRACT_OWNER == "KR-380A" and KR380A_READINESS_CONTRACT_PRODUCER == "KR-380A"
string kr380AReadinessIntegrityStatus = not kr380ASetupContractConsumable ? (not kr380ASetupVersionCompatible or not outKR370SetupContractMandatoryFieldsPresent ? PCA_INTEGRITY_INVALID : PCA_INTEGRITY_DEGRADED) : not kr380ALegacyContextVersionCompatible ? PCA_INTEGRITY_INVALID : not outExecContextAvailable ? PCA_INTEGRITY_UNAVAILABLE : PCA_INTEGRITY_VALID
PCAIntegrityRecord outKR380AReadinessContractIntegrity = pcaContractIntegrity("KR-380A", pcaObservationBoundary, pcaObservationTimestamp, outKR380AReadinessContractVersionSupported and kr380ASetupVersionCompatible and kr380ALegacyContextVersionCompatible, outKR380AReadinessContractMandatoryFieldsPresent and outKR370SetupContractMandatoryFieldsPresent, outKR380AReadinessContractSemanticCompatible, kr380AReadinessIntegrityStatus)
bool outKR380AReadinessContractValid = outKR380AReadinessContractVersionSupported and outKR380AReadinessContractMandatoryFieldsPresent and outKR380AReadinessContractSemanticCompatible and kr380ASetupContractConsumable and kr380ALegacyContextVersionCompatible
string outKR380AReadinessContractStatus = not outKR380AReadinessContractVersionSupported or not kr380ASetupVersionCompatible or not kr380ALegacyContextVersionCompatible ? "UNSUPPORTED VERSION — FAIL CLOSED" : not outKR380AReadinessContractMandatoryFieldsPresent or not outKR370SetupContractMandatoryFieldsPresent ? PCA_CONTRACT_INVALID : not outKR380AReadinessContractSemanticCompatible ? PCA_UPSTREAM_INCONSISTENT : outKR380AReadinessContractIntegrity.currentStatus

PCAKR380AReadinessContract outKR380AReadinessContract = PCAKR380AReadinessContract.new(contractIdentity = KR380A_READINESS_CONTRACT_IDENTITY, contractVersion = KR380A_READINESS_CONTRACT_VERSION, authoritativeOwner = KR380A_READINESS_CONTRACT_OWNER, producer = KR380A_READINESS_CONTRACT_PRODUCER, consumers = "KR-380", mandatoryInputs = "Published KR-370 Setup Contract | Published KR-360 Evidence Contract | Setup Identity | Setup Validity | Readiness Eligibility | Direction-aligned Opportunity | Completed MCX 1H Boundary", optionalInputs = "Momentum | Compression | Daily/4H/1H Reference Context | Review Context | Extension | Confidence Summary — explanation only | Setup Quality — explanation only", mandatoryOutputs = "Readiness Policy | Setup References | Readiness State | Condition Evaluation Records | Timing | Extension | Primary Readiness Blocker | Lifecycle and Transition schema", integrityStates = "UNKNOWN | UNAVAILABLE | INVALID | STALE | NOT EVALUATED | DEGRADED", observationBoundary = pcaObservationBoundary, timestamp = pcaObservationTimestamp, failureBehavior = "Fail closed; never invalidate setup; never infer readiness; preserve inconsistency", compatibilityRule = "Unsupported version fails closed; missing field is INVALID CONTRACT; semantic mismatch is UPSTREAM INCONSISTENT", prohibitedAuthority = "Setup Invalidation | BUY NOW | SELL NOW | Execution Authority | Risk Approval | Position Size | Order Type | Broker Interaction | Canonical Pine State | Operator Instruction | Canonical KRONOS Swing Decision", readinessPolicyIdentity = KR380A_READINESS_POLICY_IDENTITY, readinessPolicyVersion = KR380A_READINESS_POLICY_VERSION, applicableSetupFamily = outKR370SetupContract.setupFamily, upstreamSetupIdentity = outKR370SetupContract.setupIdentity, upstreamSetupValidity = outKR370SetupContract.setupValidity, upstreamReadinessEligibility = outKR370SetupContract.readinessEligibility, readinessState = kr380AReadinessState, mandatoryConditionEvaluations = outKR380AMandatoryConditionEvaluations, optionalSupportEvaluations = outKR380AOptionalSupportEvaluations, readinessReductionEvaluations = outKR380AReadinessReductionEvaluations, explicitVetoEvaluations = outKR380AExplicitVetoEvaluations, timingState = kr380ATimingState, extensionState = kr380AExtensionState, primaryReadinessBlocker = outKR380APrimaryReadinessBlocker, persistenceStatus = kr380AReadinessLifecycle.persistenceStatus, regressionStatus = kr380AReadinessLifecycle.regressionStatus, expiryStatus = kr380AReadinessLifecycle.expiryStatusAndCause, priorReadinessState = kr380AReadinessLifecycle.priorState, transitionCause = kr380AReadinessLifecycle.transitionCause, appliedReadinessRule = kr380AReadinessLifecycle.appliedRule, transitionRecord = outKR380AReadinessTransition, integrity = outKR380AReadinessContractIntegrity)



//==================================================================
// KR-380 : Canonical Pine State Producer / Legacy Execution Trigger Compatibility
// Version : 1.0.0
// Status  : FROZEN
// Last Updated : 2026-07-10
//
// Purpose:
// Synthesizes the published KR-370 setup contract and KR-380A
// readiness contract into canonical Pine state and legacy outputs.
//
// Validation Scope:
// - Execution timing validation on Copper, Gold, and Silver.
// - Confirmed MCX 1H finality for BUY NOW, SELL NOW, FAILED, and
//   EXTENDED.
//
// Frozen Contract:
// - KR-370 owns setup direction and validity.
// - KR-380A owns readiness, timing, extension, and readiness blockers.
// - KR-380 consumes contracts and does not requalify readiness.
// - Intrabar state may be FORMING.
// - BUY NOW, SELL NOW, FAILED and EXTENDED require a confirmed
//   MCX 1H bar.
// - No alerts.
// - No trade management.
// - No stops, targets, labels, plots or orders.
//==================================================================

//==================================================================
// KR-380.10 TRIGGER STATE CONSTANTS
//==================================================================

const int KR380_TRIGGER_NONE = 0
const int KR380_TRIGGER_FORMING_LONG = 1
const int KR380_TRIGGER_FORMING_SHORT = 2
const int KR380_TRIGGER_BUY = 3
const int KR380_TRIGGER_SELL = 4
const int KR380_TRIGGER_FAILED = 5
const int KR380_TRIGGER_EXTENDED = 6

//==================================================================
// KR-380.20 INPUT READINESS
//==================================================================

// Package B: KR-380 consumes the authoritative setup and readiness
// contracts. It does not re-evaluate evidence, Confidence, thresholds,
// blockers, timing, or qualification.
bool triggerBaseReady = outKR370SetupContractValid and outKR380AReadinessContractValid

//==================================================================
// KR-380.25 EXECUTION CONTEXT INPUT MAP
//==================================================================

bool triggerLongIntent = outKR370SetupContract.setupDirection == "LONG"
bool triggerShortIntent = outKR370SetupContract.setupDirection == "SHORT"
bool triggerDirectionalIntent = triggerLongIntent or triggerShortIntent

bool triggerContextConsumable = outKR380AReadinessContractValid
bool triggerContextQualified = triggerContextConsumable and outKR380AReadinessContract.readinessState == "QUALIFIED"
bool triggerContextExtended = triggerContextConsumable and outKR380AReadinessContract.readinessState == "EXPIRED FOR ACTION"
bool triggerContextFailed = triggerContextConsumable and outKR380AReadinessContract.readinessState == "BLOCKED"
bool triggerBarConfirmed = triggerContextConsumable and outKR380AReadinessContract.timingState == "TIMELY"

//==================================================================
// KR-380.30 PUBLIC CONDITION MAP
//==================================================================

bool triggerBuyReady = triggerBaseReady and triggerContextQualified and triggerLongIntent
bool triggerSellReady = triggerBaseReady and triggerContextQualified and triggerShortIntent
bool triggerReadySetup = triggerBuyReady or triggerSellReady

bool triggerExtended = triggerDirectionalIntent and triggerContextExtended
bool triggerFailed = triggerDirectionalIntent and triggerContextFailed
bool triggerExtendedFinal = triggerExtended
bool triggerFailedFinal = triggerFailed

bool triggerExecutionContextReady = triggerContextQualified

bool triggerBuyNow = triggerBuyReady
bool triggerSellNow = triggerSellReady

bool triggerLongForming = triggerBaseReady and triggerLongIntent and not triggerBuyNow and not triggerExtendedFinal and not triggerFailedFinal
bool triggerShortForming = triggerBaseReady and triggerShortIntent and not triggerSellNow and not triggerExtendedFinal and not triggerFailedFinal

//==================================================================
// KR-380.35 EXECUTION NEEDS
//==================================================================

string triggerExecutionNeed1 = triggerBuyNow or triggerSellNow ? "" : outKR380AReadinessContract.primaryReadinessBlocker.nextRequiredEvent
string triggerExecutionNeed2 = ""
string triggerExecutionNeed3 = ""
string triggerExecutionPrimaryBlocker = triggerBuyNow or triggerSellNow ? "" : outKR380AReadinessContract.primaryReadinessBlocker.blockerIdentity
string triggerExecutionReason = triggerBuyNow or triggerSellNow ? "Readiness qualified by KR-380A" : triggerExecutionPrimaryBlocker == "" or triggerExecutionPrimaryBlocker == "NONE" ? "Waiting for KR-380A readiness" : triggerExecutionPrimaryBlocker

//==================================================================
// KR-380.40 TRIGGER CLASSIFICATION
//==================================================================

int triggerState = KR380_TRIGGER_NONE
string triggerReason = ""

if not triggerBaseReady
    triggerState := KR380_TRIGGER_NONE
    triggerReason := "Waiting for market data"
else if triggerFailedFinal
    triggerState := KR380_TRIGGER_FAILED
    triggerReason := triggerExecutionReason
else if triggerExtendedFinal
    triggerState := KR380_TRIGGER_EXTENDED
    triggerReason := triggerExecutionReason
else if triggerBuyNow
    triggerState := KR380_TRIGGER_BUY
    triggerReason := "Entry timing confirmed"
else if triggerSellNow
    triggerState := KR380_TRIGGER_SELL
    triggerReason := "Entry timing confirmed"
else if triggerLongForming
    triggerState := KR380_TRIGGER_FORMING_LONG
    triggerReason := triggerExecutionReason
else if triggerShortForming
    triggerState := KR380_TRIGGER_FORMING_SHORT
    triggerReason := triggerExecutionReason
else if not triggerReadySetup
    triggerState := KR380_TRIGGER_NONE
    triggerReason := triggerExecutionReason
else
    triggerState := KR380_TRIGGER_NONE
    triggerReason := triggerExecutionReason

string triggerText = ""

switch triggerState
    KR380_TRIGGER_FORMING_LONG => triggerText := "FORMING"
    KR380_TRIGGER_FORMING_SHORT => triggerText := "FORMING"
    KR380_TRIGGER_BUY => triggerText := "BUY NOW"
    KR380_TRIGGER_SELL => triggerText := "SELL NOW"
    KR380_TRIGGER_FAILED => triggerText := "FAILED"
    KR380_TRIGGER_EXTENDED => triggerText := "EXTENDED"
    => triggerText := "NO TRIGGER"

//==================================================================
// KR-380.50 PUBLIC INTERFACE
//==================================================================

bool outTriggerReady = triggerBaseReady
bool outTriggerBarConfirmed = triggerBarConfirmed

int outTriggerState = triggerState

string outTriggerText = triggerText
string outTriggerReason = triggerReason

bool outTriggerNone = triggerState == KR380_TRIGGER_NONE
bool outTriggerFormingLong = triggerState == KR380_TRIGGER_FORMING_LONG
bool outTriggerFormingShort = triggerState == KR380_TRIGGER_FORMING_SHORT
bool outTriggerBuy = triggerState == KR380_TRIGGER_BUY
bool outTriggerSell = triggerState == KR380_TRIGGER_SELL
bool outTriggerFailed = triggerState == KR380_TRIGGER_FAILED
bool outTriggerExtended = triggerState == KR380_TRIGGER_EXTENDED

bool outExecutionContextReady = triggerExecutionContextReady

string outExecutionNeed1 = triggerExecutionNeed1
string outExecutionNeed2 = triggerExecutionNeed2
string outExecutionNeed3 = triggerExecutionNeed3
string outExecutionPrimaryBlocker = triggerExecutionPrimaryBlocker
string outExecutionReason = triggerExecutionReason

//==================================================================
// KR-380.60 PCA-006 CANONICAL PINE STATE CONTRACT — PACKAGE B CONSUMER
//==================================================================

const string KR380_PINE_STATE_CONTRACT_IDENTITY = "KR-380 Canonical Pine State Contract"
const string KR380_PINE_STATE_CONTRACT_VERSION = PCA_CONTRACT_VERSION_1_0
const string KR380_PINE_STATE_CONTRACT_OWNER = "KR-380"
const string KR380_PINE_STATE_CONTRACT_PRODUCER = "KR-380"

bool kr380SetupVersionCompatible = outKR370SetupContract.contractVersion == PCA_CONTRACT_VERSION_1_0
bool kr380ReadinessVersionCompatible = outKR380AReadinessContract.contractVersion == PCA_CONTRACT_VERSION_1_0
bool kr380SetupIdentityCompatible = outKR370SetupContract.contractIdentity == KR370_SETUP_CONTRACT_IDENTITY
bool kr380ReadinessIdentityCompatible = outKR380AReadinessContract.contractIdentity == KR380A_READINESS_CONTRACT_IDENTITY
bool kr380TemporalCompatible = outKR370SetupContract.observationBoundary == outKR380AReadinessContract.observationBoundary and outKR370SetupContract.timestamp == outKR380AReadinessContract.timestamp
bool kr380SourceOwnersCompatible = outKR370SetupContract.authoritativeOwner == "KR-370" and outKR370SetupContract.producer == "KR-370" and outKR380AReadinessContract.authoritativeOwner == "KR-380A" and outKR380AReadinessContract.producer == "KR-380A"
bool kr380CrossEngineSemanticCompatible = kr380SetupIdentityCompatible and kr380ReadinessIdentityCompatible and kr380SourceOwnersCompatible and kr380TemporalCompatible
string kr380SourceIntegrityStatus = not outKR370SetupContractValid or not outKR380AReadinessContractValid ? PCA_INTEGRITY_INVALID : outKR370SetupContractIntegrity.currentStatus == PCA_INTEGRITY_UNAVAILABLE or outKR380AReadinessContractIntegrity.currentStatus == PCA_INTEGRITY_UNAVAILABLE ? PCA_INTEGRITY_UNAVAILABLE : outKR370SetupContractIntegrity.currentStatus == PCA_INTEGRITY_DEGRADED or outKR380AReadinessContractIntegrity.currentStatus == PCA_INTEGRITY_DEGRADED ? PCA_INTEGRITY_DEGRADED : outKR370SetupContractIntegrity.currentStatus == PCA_INTEGRITY_STALE or outKR380AReadinessContractIntegrity.currentStatus == PCA_INTEGRITY_STALE ? PCA_INTEGRITY_STALE : PCA_INTEGRITY_VALID

string kr380CanonicalPineState = "PINE STATE NOT EVALUATED"

if not kr380SetupVersionCompatible or not kr380ReadinessVersionCompatible
    kr380CanonicalPineState := "UPSTREAM INCONSISTENT"
else if not outKR370SetupContractMandatoryFieldsPresent or not outKR380AReadinessContractMandatoryFieldsPresent
    kr380CanonicalPineState := "PINE STATE UNAVAILABLE"
else if not kr380CrossEngineSemanticCompatible
    kr380CanonicalPineState := "UPSTREAM INCONSISTENT"
else if kr380SourceIntegrityStatus == PCA_INTEGRITY_INVALID
    kr380CanonicalPineState := "UPSTREAM INCONSISTENT"
else if kr380SourceIntegrityStatus == PCA_INTEGRITY_UNAVAILABLE
    kr380CanonicalPineState := "PINE STATE UNAVAILABLE"
else if kr380SourceIntegrityStatus == PCA_INTEGRITY_STALE
    kr380CanonicalPineState := "PINE STATE STALE"
else if kr380SourceIntegrityStatus == PCA_INTEGRITY_DEGRADED
    kr380CanonicalPineState := "PINE STATE DEGRADED"
else if outKR370SetupContract.setupState == "DIRECTIONALLY CONFLICTED"
    kr380CanonicalPineState := "DIRECTIONALLY CONFLICTED"
else if outKR370SetupContract.setupState == "SETUP ANALYTICALLY BLOCKED"
    kr380CanonicalPineState := "ANALYTICALLY BLOCKED"
else if outKR370SetupContract.setupState == "NO SETUP"
    kr380CanonicalPineState := "NO ANALYTICAL SETUP"
else if outKR380AReadinessContract.readinessState == "BLOCKED"
    kr380CanonicalPineState := "READINESS BLOCKED"
else if outKR370SetupContract.setupState == "WATCH LONG"
    kr380CanonicalPineState := "WATCH LONG"
else if outKR370SetupContract.setupState == "WATCH SHORT"
    kr380CanonicalPineState := "WATCH SHORT"
else if outKR370SetupContract.setupValidity == "VALID" and outKR370SetupContract.setupDirection == "LONG" and outKR380AReadinessContract.readinessState == "QUALIFIED"
    kr380CanonicalPineState := "LONG ACTION READINESS QUALIFIED"
else if outKR370SetupContract.setupValidity == "VALID" and outKR370SetupContract.setupDirection == "SHORT" and outKR380AReadinessContract.readinessState == "QUALIFIED"
    kr380CanonicalPineState := "SHORT ACTION READINESS QUALIFIED"
else if outKR370SetupContract.setupValidity == "VALID" and outKR370SetupContract.setupDirection == "LONG"
    kr380CanonicalPineState := "LONG SETUP VALID — NOT READY"
else if outKR370SetupContract.setupValidity == "VALID" and outKR370SetupContract.setupDirection == "SHORT"
    kr380CanonicalPineState := "SHORT SETUP VALID — NOT READY"
else
    kr380CanonicalPineState := "NO ACTIONABLE PINE CANDIDATE"

string kr380DisplayLabel = kr380CanonicalPineState
bool kr380AnalyticalBlockerActive = outKR370SetupContract.primaryAnalyticalBlocker.currentStatus == "ACTIVE"
bool kr380ReadinessBlockerActive = outKR380AReadinessContract.primaryReadinessBlocker.currentStatus == "ACTIVE"
PCABlockerRecord outKR380PrimaryBlocker = kr380AnalyticalBlockerActive ? outKR370SetupContract.primaryAnalyticalBlocker : kr380ReadinessBlockerActive ? outKR380AReadinessContract.primaryReadinessBlocker : PCABlockerRecord.new("NONE", "NONE", "NONE", "NONE", "INACTIVE", "NONE", pcaObservationBoundary, pcaObservationTimestamp, "NONE")
string kr380MaterialSecondaryBlockers = kr380AnalyticalBlockerActive and kr380ReadinessBlockerActive ? outKR380AReadinessContract.primaryReadinessBlocker.blockerIdentity : "NONE"
string kr380CandidateNextState = "NEXT STATE UNRESOLVED"
string kr380CandidateNextStateOwner = "KR-380"
string kr380RequiredTransitionConditions = outKR380PrimaryBlocker.nextRequiredEvent
string kr380SupportingEvidenceSummary = outKR370SetupContract.supportingEvidenceReferences
string kr380ContradictoryEvidenceSummary = outKR370SetupContract.contradictoryEvidenceReferences
string kr380MissingMandatoryEvidence = outKR370SetupContract.missingMandatoryEvidence
string kr380WhyCurrentStateExists = "KR-370 " + outKR370SetupContract.setupState + " | KR-380A " + outKR380AReadinessContract.readinessState
PCAExplanationRecord outKR380Explanation = PCAExplanationRecord.new(kr380WhyCurrentStateExists, kr380SupportingEvidenceSummary, kr380ContradictoryEvidenceSummary, kr380MissingMandatoryEvidence, outKR380PrimaryBlocker.blockerIdentity, kr380RequiredTransitionConditions, PCA_AUTHORITY_LIMITATION)
PCALifecycleEvaluation kr380CanonicalLifecycle = pcaPackageCCanonicalLifecycle(kr380CanonicalPineState, outKR370SetupTransition.assessmentStatus, outKR380AReadinessTransition.assessmentStatus, outKR380PrimaryBlocker.blockerIdentity)

bool outKR380PineStateContractVersionSupported = pcaVersionSupported(KR380_PINE_STATE_CONTRACT_VERSION, PCA_CONTRACT_VERSION_1_0)
bool outKR380PineStateContractMandatoryFieldsPresent = pcaMandatoryStringPresent(KR380_PINE_STATE_CONTRACT_IDENTITY) and pcaMandatoryStringPresent(kr380CanonicalPineState) and pcaMandatoryStringPresent(kr380DisplayLabel) and pcaMandatoryStringPresent(outKR370SetupContract.setupState) and pcaMandatoryStringPresent(outKR380AReadinessContract.readinessState) and pcaMandatoryStringPresent(outKR370SetupContract.contractIdentity) and pcaMandatoryStringPresent(outKR380AReadinessContract.contractIdentity) and pcaMandatoryStringPresent(pcaObservationBoundary)
bool outKR380PineStateContractSemanticCompatible = kr380CrossEngineSemanticCompatible and KR380_PINE_STATE_CONTRACT_OWNER == "KR-380" and KR380_PINE_STATE_CONTRACT_PRODUCER == "KR-380"
PCAIntegrityRecord outKR380PineStateContractIntegrity = pcaContractIntegrity("KR-380", pcaObservationBoundary, pcaObservationTimestamp, outKR380PineStateContractVersionSupported and kr380SetupVersionCompatible and kr380ReadinessVersionCompatible, outKR380PineStateContractMandatoryFieldsPresent and outKR370SetupContractMandatoryFieldsPresent and outKR380AReadinessContractMandatoryFieldsPresent, outKR380PineStateContractSemanticCompatible, kr380SourceIntegrityStatus)
bool outKR380PineStateContractValid = outKR380PineStateContractVersionSupported and outKR380PineStateContractMandatoryFieldsPresent and outKR380PineStateContractSemanticCompatible and outKR370SetupContractValid and outKR380AReadinessContractValid
string outKR380PineStateContractStatus = not outKR380PineStateContractVersionSupported or not kr380SetupVersionCompatible or not kr380ReadinessVersionCompatible ? "UNSUPPORTED VERSION — FAIL CLOSED" : not outKR380PineStateContractMandatoryFieldsPresent or not outKR370SetupContractMandatoryFieldsPresent or not outKR380AReadinessContractMandatoryFieldsPresent ? PCA_CONTRACT_INVALID : not outKR380PineStateContractSemanticCompatible ? PCA_UPSTREAM_INCONSISTENT : outKR380PineStateContractIntegrity.currentStatus

PCAKR380CanonicalPineStateContract outKR380CurrentPineStateContractInstance = PCAKR380CanonicalPineStateContract.new(contractIdentity = KR380_PINE_STATE_CONTRACT_IDENTITY, contractVersion = KR380_PINE_STATE_CONTRACT_VERSION, authoritativeOwner = KR380_PINE_STATE_CONTRACT_OWNER, producer = KR380_PINE_STATE_CONTRACT_PRODUCER, consumers = "Trader Workstation", mandatoryInputs = "Published KR-370 Setup Contract | Published KR-380A Readiness Contract | Source Integrity | Cross-Engine Compatibility | Temporal Compatibility | Observation Boundary", optionalInputs = "Confidence Summary — explanatory only | Confidence Components Reference", mandatoryOutputs = "Canonical Pine State | Display Label | Current Pine State Contract Instance | Source States | Source Contracts | Source Timestamps | Compatibility | Integrity | Blockers | Candidate Next State | Explanation | Boundary | Timestamp | Transition schema", integrityStates = "UNKNOWN | UNAVAILABLE | INVALID | STALE | NOT EVALUATED | DEGRADED", observationBoundary = pcaObservationBoundary, timestamp = pcaObservationTimestamp, failureBehavior = "Publish degraded, unavailable, unknown or inconsistent state; never infer upstream outputs; never preserve favorable state after integrity loss", compatibilityRule = "Unsupported version fails closed; missing field is INVALID CONTRACT; semantic mismatch is UPSTREAM INCONSISTENT", prohibitedAuthority = "BUY NOW | SELL NOW | Operator Instruction | Canonical KRONOS Swing Decision | Position Size | Order Type | Broker Interaction | Risk Approval | Setup Reassessment | Readiness Requalification", canonicalPineState = kr380CanonicalPineState, displayLabel = kr380DisplayLabel, sourceSetupState = outKR370SetupContract.setupState, sourceReadinessState = outKR380AReadinessContract.readinessState, sourceKR370ContractIdentity = outKR370SetupContract.contractIdentity, sourceKR370ContractVersion = outKR370SetupContract.contractVersion, sourceKR380AContractIdentity = outKR380AReadinessContract.contractIdentity, sourceKR380AContractVersion = outKR380AReadinessContract.contractVersion, sourceSetupTimestamp = outKR370SetupContract.timestamp, sourceReadinessTimestamp = outKR380AReadinessContract.timestamp, temporalCompatibilityResult = kr380TemporalCompatible ? "COMPATIBLE" : PCA_UPSTREAM_INCONSISTENT, sourceIntegrityStatus = kr380SourceIntegrityStatus, primaryBlocker = outKR380PrimaryBlocker, materialSecondaryBlockers = kr380MaterialSecondaryBlockers, candidateNextState = kr380CandidateNextState, candidateNextStateOwner = kr380CandidateNextStateOwner, requiredTransitionConditions = kr380RequiredTransitionConditions, explanationRecord = outKR380Explanation, priorCanonicalPineState = kr380CanonicalLifecycle.priorState, presentationRule = kr380CanonicalLifecycle.appliedRule, transitionCause = kr380CanonicalLifecycle.transitionCause, transitionTimestamp = pcaObservationTimestamp, assessmentStatus = kr380CanonicalLifecycle.assessmentStatus, integrity = outKR380PineStateContractIntegrity)

string outCanonicalPineState = outKR380CurrentPineStateContractInstance.canonicalPineState
string outCanonicalPineDisplayLabel = outKR380CurrentPineStateContractInstance.displayLabel

//==================================================================
// END OF KR-380
//==================================================================



//==================================================================
// KR-390A : Trade Management Execution Adapter
// Version : 0.1.0
// Status  : FOUNDATION
// Last Updated : 2026-07-10
//
// Purpose:
// Provides the narrow confirmed execution-timeframe structure facts
// required by KR-390. This adapter is intentionally small and does
// not duplicate KR-275 or create a new structure engine.
//
// Stop Source:
// - Long stop uses the lowest completed MCX 1H low from the prior
//   five execution bars.
// - Short stop uses the highest completed MCX 1H high from the prior
//   five execution bars.
// - These are model stop references, not broker instructions.
//==================================================================

const int KR390_EXECUTION_SWING_LOOKBACK = 5

float tradeExecutionConfirmedSwingLow = ta.lowest(mdPrimaryExecutionL[1], KR390_EXECUTION_SWING_LOOKBACK)
float tradeExecutionConfirmedSwingHigh = ta.highest(mdPrimaryExecutionH[1], KR390_EXECUTION_SWING_LOOKBACK)

bool tradeExecutionContextReady = assetMarket == "MCX" and timeframe.isintraday and timeframe.multiplier == 60 and not na(mdPrimaryExecutionC)

bool outTradeExecutionContextReady = tradeExecutionContextReady
bool outTradeExecutionStopReady = outTradeExecutionContextReady and not na(tradeExecutionConfirmedSwingLow) and not na(tradeExecutionConfirmedSwingHigh)

float outTradeExecutionClose = mdPrimaryExecutionC
float outTradeExecutionSwingLow = tradeExecutionConfirmedSwingLow
float outTradeExecutionSwingHigh = tradeExecutionConfirmedSwingHigh



//==================================================================
// KR-390 : Trade Management Engine
// Version : 0.1.0
// Status  : FOUNDATION
// Last Updated : 2026-07-10
//
// Purpose:
// Manages a persistent model trade after a confirmed KR-380 BUY NOW
// or SELL NOW trigger.
//
// Contract:
// - KR-370 owns direction/readiness.
// - KR-380 owns entry timing.
// - KR-390 owns post-trigger model trade state and protection.
// - No alerts, broker orders, position sizing, partial exits, stops
//   sent to broker, targets sent to broker, plots or labels.
// - Model entry price is the confirmed MCX 1H trigger-bar close and
//   is not the user's broker fill.
//==================================================================

//==================================================================
// KR-390.10 TRADE STATE CONSTANTS
//==================================================================

const int KR390_TRADE_NONE = 0
const int KR390_TRADE_ACTIVE = 1
const int KR390_TRADE_HOLD = 2
const int KR390_TRADE_PROTECT = 3
const int KR390_TRADE_TRAIL = 4
const int KR390_TRADE_EXIT = 5
const int KR390_TRADE_INVALIDATED = 6

const int KR390_DIRECTION_SHORT = -1
const int KR390_DIRECTION_NONE = 0
const int KR390_DIRECTION_LONG = 1

//==================================================================
// KR-390.20 PERSISTENT MODEL TRADE MEMORY
//==================================================================

var bool tradeModelActive = false
var int tradeModelDirection = KR390_DIRECTION_NONE
var int tradeModelState = KR390_TRADE_NONE
var int tradeModelEntryBarIndex = na

var float tradeModelEntryPrice = na
var float tradeInitialStopPrice = na
var float tradeManagedStopPrice = na
var float tradeTarget1Price = na
var float tradeTarget2Price = na
var float tradeInitialRisk = na

var string tradeModelReason = "No confirmed trigger"

//==================================================================
// KR-390.30 START CONDITIONS
//==================================================================

bool tradeStartLongSignal = outTriggerBuy and outTriggerBarConfirmed and outTradeExecutionContextReady
bool tradeStartShortSignal = outTriggerSell and outTriggerBarConfirmed and outTradeExecutionContextReady
bool tradeStartSignal = tradeStartLongSignal or tradeStartShortSignal

float tradeCandidateEntryPrice = outTradeExecutionClose
float tradeCandidateInitialStop = tradeStartLongSignal ? outTradeExecutionSwingLow : tradeStartShortSignal ? outTradeExecutionSwingHigh : na
float tradeCandidateRisk = math.abs(tradeCandidateEntryPrice - tradeCandidateInitialStop)

bool tradeCandidateDataReady = outTradeExecutionContextReady and outTradeExecutionStopReady and not na(tradeCandidateEntryPrice) and not na(tradeCandidateInitialStop)
bool tradeCandidateLongValid = tradeStartLongSignal and tradeCandidateDataReady and tradeCandidateInitialStop < tradeCandidateEntryPrice and tradeCandidateRisk > 0.0
bool tradeCandidateShortValid = tradeStartShortSignal and tradeCandidateDataReady and tradeCandidateInitialStop > tradeCandidateEntryPrice and tradeCandidateRisk > 0.0
bool tradeCandidateValid = tradeCandidateLongValid or tradeCandidateShortValid

//==================================================================
// KR-390.40 ACTIVE TRADE MANAGEMENT
//==================================================================

bool tradeConfirmedManagementBar = outTradeExecutionContextReady and barstate.isconfirmed
bool tradeLongActive = tradeModelActive and tradeModelDirection == KR390_DIRECTION_LONG
bool tradeShortActive = tradeModelActive and tradeModelDirection == KR390_DIRECTION_SHORT

if tradeModelActive and tradeConfirmedManagementBar
    bool tradeLongStopBreached = tradeLongActive and outTradeExecutionClose <= tradeManagedStopPrice
    bool tradeShortStopBreached = tradeShortActive and outTradeExecutionClose >= tradeManagedStopPrice

    if tradeLongStopBreached or tradeShortStopBreached
        tradeModelActive := false
        tradeModelState := KR390_TRADE_EXIT
        tradeModelReason := "Managed stop breached on confirmed MCX 1H close"
    else
        float tradeProgress = tradeLongActive ? outTradeExecutionClose - tradeModelEntryPrice : tradeShortActive ? tradeModelEntryPrice - outTradeExecutionClose : 0.0
        float tradeRMultiple = tradeInitialRisk > 0.0 ? tradeProgress / tradeInitialRisk : 0.0

        if tradeRMultiple >= 2.0 and outTradeExecutionStopReady
            if tradeLongActive
                tradeManagedStopPrice := math.max(tradeManagedStopPrice, math.max(tradeModelEntryPrice, outTradeExecutionSwingLow))
            else if tradeShortActive
                tradeManagedStopPrice := math.min(tradeManagedStopPrice, math.min(tradeModelEntryPrice, outTradeExecutionSwingHigh))

            tradeModelState := KR390_TRADE_TRAIL
            tradeModelReason := "Trailing stop from confirmed execution structure"
        else if tradeRMultiple >= 1.0
            if tradeLongActive
                tradeManagedStopPrice := math.max(tradeManagedStopPrice, tradeModelEntryPrice)
            else if tradeShortActive
                tradeManagedStopPrice := math.min(tradeManagedStopPrice, tradeModelEntryPrice)

            tradeModelState := KR390_TRADE_PROTECT
            tradeModelReason := "Initial risk protected at 1R progress"
        else
            tradeModelState := KR390_TRADE_HOLD
            tradeModelReason := "Model trade active"

//==================================================================
// KR-390.50 TRADE START / INVALIDATION
//==================================================================

if not tradeModelActive and tradeStartSignal
    if tradeCandidateValid
        tradeModelActive := true
        tradeModelDirection := tradeStartLongSignal ? KR390_DIRECTION_LONG : KR390_DIRECTION_SHORT
        tradeModelEntryPrice := tradeCandidateEntryPrice
        tradeInitialStopPrice := tradeCandidateInitialStop
        tradeManagedStopPrice := tradeCandidateInitialStop
        tradeInitialRisk := tradeCandidateRisk
        tradeModelEntryBarIndex := bar_index

        if tradeStartLongSignal
            tradeTarget1Price := tradeModelEntryPrice + tradeInitialRisk
            tradeTarget2Price := tradeModelEntryPrice + tradeInitialRisk * 2.0
        else
            tradeTarget1Price := tradeModelEntryPrice - tradeInitialRisk
            tradeTarget2Price := tradeModelEntryPrice - tradeInitialRisk * 2.0

        tradeModelState := KR390_TRADE_ACTIVE
        tradeModelReason := "Confirmed KR-380 trigger started model trade"
    else
        tradeModelActive := false
        tradeModelState := KR390_TRADE_INVALIDATED
        tradeModelReason := "Entry or initial stop unavailable"

else if tradeModelActive and tradeStartSignal
    tradeModelReason := "Active model trade; new trigger ignored"

else if not tradeModelActive and tradeModelState != KR390_TRADE_EXIT and tradeModelState != KR390_TRADE_INVALIDATED
    tradeModelState := KR390_TRADE_NONE
    tradeModelReason := "No confirmed trigger"

//==================================================================
// KR-390.60 PUBLIC CLASSIFICATION
//==================================================================

string tradeModelText = ""

switch tradeModelState
    KR390_TRADE_ACTIVE => tradeModelText := "HOLD"
    KR390_TRADE_HOLD => tradeModelText := "HOLD"
    KR390_TRADE_PROTECT => tradeModelText := "PROTECT"
    KR390_TRADE_TRAIL => tradeModelText := "TRAIL"
    KR390_TRADE_EXIT => tradeModelText := "EXIT"
    KR390_TRADE_INVALIDATED => tradeModelText := "INVALIDATED"
    => tradeModelText := "NO TRADE"

//==================================================================
// KR-390.70 PUBLIC INTERFACE
//==================================================================

bool outTradeManagementReady = outTradeExecutionContextReady

bool outTradeActive = tradeModelActive
int outTradeDirection = tradeModelDirection
int outTradeState = tradeModelState

string outTradeText = tradeModelText
string outTradeReason = tradeModelReason

float outModelEntryPrice = tradeModelEntryPrice
float outInitialStopPrice = tradeInitialStopPrice
float outManagedStopPrice = tradeManagedStopPrice
float outTarget1Price = tradeTarget1Price
float outTarget2Price = tradeTarget2Price

bool outTradeHold = tradeModelState == KR390_TRADE_ACTIVE or tradeModelState == KR390_TRADE_HOLD
bool outTradeProtect = tradeModelState == KR390_TRADE_PROTECT
bool outTradeTrail = tradeModelState == KR390_TRADE_TRAIL
bool outTradeExit = tradeModelState == KR390_TRADE_EXIT
bool outTradeInvalidated = tradeModelState == KR390_TRADE_INVALIDATED

//==================================================================
// END OF KR-390
//==================================================================



//==================================================================
// KR-400 : Execution Alert Engine
// Version : 0.1.0
// Status  : FOUNDATION
// Last Updated : 2026-07-10
//
// Purpose:
// Creates TradingView alerts only when a new confirmed KR-380 BUY NOW
// or SELL NOW event occurs.
//
// Contract:
// - KR-380 owns execution timing.
// - KR-400 consumes KR-380 public outputs only.
// - Alerts fire only for new confirmed BUY NOW / SELL NOW events.
// - Alerts are TradingView alerts.
// - Mobile delivery depends on the user enabling push notifications
//   in TradingView.
// - No broker order is placed.
// - No automated trade execution occurs.
//==================================================================

//==================================================================
// KR-400.10 ALERT CONTEXT
//==================================================================

bool alertContextValid = outTriggerReady and outTriggerBarConfirmed and barstate.isconfirmed
bool alertBuyEvent = alertContextValid and outTriggerBuy and not (outTriggerBuy[1] == true)
bool alertSellEvent = alertContextValid and outTriggerSell and not (outTriggerSell[1] == true)

//==================================================================
// KR-400.20 TRADINGVIEW ALERT CONDITIONS
//==================================================================

alertcondition(alertBuyEvent, title="KRONOS BUY NOW", message="KRONOS BUY NOW | {{ticker}} | {{interval}} | Price: {{close}}")

alertcondition(alertSellEvent, title="KRONOS SELL NOW", message="KRONOS SELL NOW | {{ticker}} | {{interval}} | Price: {{close}}")

//==================================================================
// KR-400.30 PUBLIC INTERFACE
//==================================================================

bool outAlertBuyEvent = alertBuyEvent
bool outAlertSellEvent = alertSellEvent
bool outAlertReady = outTriggerReady

string outAlertStatusText = outAlertBuyEvent ? "BUY ALERT FIRED" : outAlertSellEvent ? "SELL ALERT FIRED" : outAlertReady ? "READY" : "INVALID CONTEXT"

//==================================================================
// END OF KR-400
//==================================================================



//==================================================================
// KR-705 : PACKAGE D VALIDATION WORKSTATION
// Status  : CONTROLLED CANDIDATE PRESENTATION
//
// Trader mode preserves the production trader vocabulary and adds one
// V2 comparison column. Developer mode owns contract and lifecycle detail.
// This section creates no analytical, readiness, or execution authority.
//==================================================================


inpKR705Mode = input.string("Trader", "Panel Mode", options=["Hidden", "Trader", "Developer"], group="KR-700 Developer Tools")

kr705NeedText(string needText) =>
    string need = str.replace_all(str.replace_all(str.replace_all(needText, "☐ ", ""), "✓ ", ""), "☑ ", "")
    switch need
        "Price is extended" => "Wait for Pullback"
        "Price is Extended" => "Wait for Pullback"
        "Trend Confirmation" => "Higher TF Confirmation"
        "Waiting for trend confirmation" => "Higher TF Confirmation"
        "Compression Release" => "Breakout from Compression"
        "Waiting for setup readiness" => "Setup Readiness"
        "KR-370 publishes an eligible valid setup" => "Setup Readiness"
        "Readiness inputs satisfy the approved policy" => "Setup Readiness"
        "Waiting for market data" => "Market Data"
        "Waiting for COMEX Daily data" => "COMEX Daily Data"
        "Waiting for COMEX Daily trend alignment" => "COMEX Daily Trend Alignment"
        "Waiting for COMEX 4H data" => "COMEX 4H Data"
        "Waiting for COMEX 4H breakout" => "Wait for COMEX 4H Breakout"
        "Waiting for COMEX 4H price acceptance" => "COMEX 4H Price Acceptance"
        "Waiting for COMEX 1H data" => "COMEX 1H Data"
        "Waiting for COMEX 1H momentum" => "COMEX 1H Momentum"
        "Switch to MCX 1H chart" => "Switch to MCX 1H Chart"
        "Waiting for MCX 1H price acceptance" => "MCX 1H Price Acceptance"
        "Waiting for MCX 1H confidence" => "MCX 1H Confidence Building"
        "Waiting for MCX 1H breakout" => "MCX 1H Breakout"
        "Waiting for MCX 1H momentum" => "MCX 1H Momentum"
        "Waiting for MCX 1H confirmation" => "MCX 1H Confirmation"
        "The current MCX 1H observation boundary completes" => "MCX 1H Confirmation"
        "Waiting for opportunity" => "Opportunity Building"
        "A direction-aligned Opportunity is published" => "Opportunity Building"
        "Review gate blocked" => "Review Gate Clears"
        "The underlying barrier interaction clears" => "Review Gate Clears"
        "Higher-Timeframe Acceptance Pending" => "Price Acceptance"
        "Acceptance Pending" => "Price Acceptance"
        "Acceptance Not Confirmed" => "Price Acceptance"
        "Acceptance is reassessed by KR-360 evidence" => "Price Acceptance"
        "Confidence > 60" => "Confidence Building"
        "Directional conflict resolves in KR-360 evidence" => "Directional Alignment"
        => need

kr705Row(table panel, int row, string label, string productionValue, string v2Value, color productionColor, color background) =>
    bool compact = inpKR705Mode == "Trader"
    int labelWidth = compact ? 8 : 10
    int valueWidth = compact ? 10 : 13
    string textSize = compact ? size.tiny : size.small
    table.cell(panel, 0, row, label, width=labelWidth, text_color=color.rgb(220, 220, 220), bgcolor=background, text_size=textSize, text_halign=text.align_left)
    table.cell(panel, 1, row, productionValue, width=valueWidth, text_color=productionColor, bgcolor=background, text_size=textSize, text_halign=text.align_right)
    table.cell(panel, 2, row, v2Value, width=valueWidth, text_color=productionValue == v2Value ? productionColor : color.orange, bgcolor=background, text_size=textSize, text_halign=text.align_right)

var table kr705Panel = table.new(position.top_left, 3, 24, border_width=1, border_color=color.rgb(230, 230, 230), frame_width=1, frame_color=color.rgb(230, 230, 230))

kr705Render() =>
    bool developer = inpKR705Mode == "Developer"
    color body = color.rgb(10, 10, 10)
    color header = color.rgb(20, 20, 20)
    color muted = color.rgb(180, 180, 180)
    color normal = color.white
    color positive = color.rgb(0, 200, 83)
    color caution = color.yellow
    string dash = "—"
    bool legacyReady = outTrendDataReady and outEvidenceReady and outBarrierReady and outMomentumReady
    bool queueActive = outTriggerState != KR380_TRIGGER_NONE or outExecutionNeed1 != "" or outExecutionNeed2 != "" or outExecutionNeed3 != ""
    string legacyNeed = queueActive ? outExecutionNeed1 : outNeed1
    string productionTrend = outTrendDataReady ? outBullishTrend ? "Bullish" : outBearishTrend ? "Bearish" : "Neutral" : dash
    string productionQuality = outEvidenceReady ? outTrendQualityExcellent ? "Excellent" : outTrendQualityHealthy ? "Healthy" : outTrendQualityWeak ? "Weak" : outTrendQualityExtended ? "Extended" : "Neutral" : dash
    string productionAcceptance = outBarrierReady ? outAcceptanceStrong ? "Strong Acceptance" : outAcceptanceAccepted ? "Accepted" : outAcceptanceTesting ? "Testing" : outAcceptanceRejected ? "Rejected" : "Neutral" : dash
    string productionMomentum = outMomentumReady ? outMomentumBuilding ? "Building" : outMomentumStrong ? "Strong" : outMomentumNormal ? "Normal" : outMomentumWeakening ? "Weakening" : "Exhausted" : dash
    string productionOpportunity = outOpportunityInputReady ? outBullishOpportunityContext or outBearishOpportunityContext ? "Good" : "Limited" : dash
    string productionConfidence = outConfidenceReady ? str.tostring(outConfidenceScore) + " - " + outConfidenceText : dash
    string productionRisk = outTradeManagementReady ? outTradeText : dash
    string productionEntry = outTriggerReady ? outTriggerText : dash
    string productionNeed = legacyNeed == "" ? dash : kr705NeedText(legacyNeed)
    string productionStatus = legacyReady ? "DATA OK" : "WAITING"
    string trendEvidence = outKR360EvidenceContract.trend.observedValue
    string v2Trend = outKR360EvidenceContract.trend.availability != "AVAILABLE" ? dash : trendEvidence == "CONSOLIDATED BULLISH" ? "Bullish" : trendEvidence == "CONSOLIDATED BEARISH" ? "Bearish" : trendEvidence == "CONFLICTED" ? "Conflicted" : "Neutral"
    string qualityEvidence = outKR360EvidenceContract.evidenceQuality.observedValue
    string v2Quality = outKR360EvidenceContract.evidenceQuality.availability != "AVAILABLE" ? dash : qualityEvidence == "Excellent Trend Quality" ? "Excellent" : qualityEvidence == "Healthy Trend Quality" ? "Healthy" : qualityEvidence == "Weak Trend Quality" ? "Weak" : qualityEvidence == "Extended / Wait for Pullback" ? "Extended" : "Neutral"
    string v2Acceptance = outKR360EvidenceContract.acceptance.availability == "AVAILABLE" ? outKR360EvidenceContract.acceptance.observedValue : dash
    string momentumEvidence = outKR360EvidenceContract.momentum.observedValue
    string v2Momentum = outKR360EvidenceContract.momentum.availability != "AVAILABLE" ? dash : momentumEvidence == "Building Momentum" ? "Building" : momentumEvidence == "Strong Momentum" ? "Strong" : momentumEvidence == "Normal Momentum" ? "Normal" : momentumEvidence == "Weakening Momentum" ? "Weakening" : "Exhausted"
    string opportunityEvidence = outKR360EvidenceContract.opportunityContext.observedValue
    string v2Opportunity = outKR360EvidenceContract.opportunityContext.availability != "AVAILABLE" ? dash : opportunityEvidence == "Bullish Opportunity Context" or opportunityEvidence == "Bearish Opportunity Context" ? "Good" : "Limited"
    bool blockerActive = outKR380CurrentPineStateContractInstance.primaryBlocker.currentStatus == "ACTIVE"
    string v2Need = blockerActive ? kr705NeedText(outKR380CurrentPineStateContractInstance.primaryBlocker.nextRequiredEvent) : dash
    bool v2Ready = outKR360EvidenceContract.aggregateEvidenceIntegrity.currentStatus == PCA_INTEGRITY_VALID and outKR370SetupContract.integrity.currentStatus == PCA_INTEGRITY_VALID and outKR380AReadinessContract.integrity.currentStatus == PCA_INTEGRITY_VALID and outKR380CurrentPineStateContractInstance.integrity.currentStatus == PCA_INTEGRITY_VALID
    string v2Status = v2Ready ? "DATA OK" : "WAITING"

    if barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime
        table.set_position(kr705Panel, developer ? position.top_left : position.top_right)
        table.clear(kr705Panel, 0, 0, 2, 23)
        if inpKR705Mode != "Hidden"
            int labelWidth = developer ? 10 : 8
            int valueWidth = developer ? 13 : 10
            string textSize = developer ? size.small : size.tiny
            table.cell(kr705Panel, 0, 0, "KRONOS V2 CANDIDATE", width=labelWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_left)
            table.cell(kr705Panel, 1, 0, "ANALYTICAL ONLY", width=valueWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_right)
            table.cell(kr705Panel, 2, 0, "NOT PRODUCTION", width=valueWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_right)
            table.cell(kr705Panel, 0, 1, "DESCRIPTION", width=labelWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_left)
            table.cell(kr705Panel, 1, 1, "PRODUCTION", width=valueWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_right)
            table.cell(kr705Panel, 2, 1, developer ? "V2 • DEVELOPER" : "V2 • TRADER", width=valueWidth, text_color=color.aqua, bgcolor=header, text_size=textSize, text_halign=text.align_right)
            int row = 2
            kr705Row(kr705Panel, row, "D Trend", productionTrend, v2Trend, normal, body)
            row += 1
            kr705Row(kr705Panel, row, "Quality", productionQuality, v2Quality, normal, body)
            row += 1
            kr705Row(kr705Panel, row, "Acceptance", productionAcceptance, v2Acceptance, normal, body)
            row += 1
            kr705Row(kr705Panel, row, "Momentum", productionMomentum, v2Momentum, normal, body)
            row += 1
            kr705Row(kr705Panel, row, "Opportunity", productionOpportunity, v2Opportunity, normal, body)
            row += 1
            if developer
                kr705Row(kr705Panel, row, "Setup", outDecisionText, outKR370SetupContract.setupState, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Readiness", outTriggerText, outKR380AReadinessContract.readinessState, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Pine State", outDecisionText, outKR380CurrentPineStateContractInstance.displayLabel, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Blocker", outExecutionPrimaryBlocker == "" ? "NONE" : outExecutionPrimaryBlocker, blockerActive ? outKR380CurrentPineStateContractInstance.primaryBlocker.blockerIdentity : "NONE", muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Owner / Class", dash, blockerActive ? outKR380CurrentPineStateContractInstance.primaryBlocker.owner + " / " + outKR380CurrentPineStateContractInstance.primaryBlocker.blockerClass : "NONE", muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Lifecycle", dash, outKR380CurrentPineStateContractInstance.assessmentStatus, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Integrity", productionStatus, "S " + outKR370SetupContract.integrity.currentStatus + " | R " + outKR380AReadinessContract.integrity.currentStatus + " | P " + outKR380CurrentPineStateContractInstance.integrity.currentStatus, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Boundary", dash, outKR380CurrentPineStateContractInstance.observationBoundary, muted, body)
                row += 1
                kr705Row(kr705Panel, row, "Transition", dash, outKR380CurrentPineStateContractInstance.transitionCause, muted, body)
                row += 1
            kr705Row(kr705Panel, row, "Confidence", productionConfidence, productionConfidence, normal, body)
            row += 1
            kr705Row(kr705Panel, row, "Risk", productionRisk, dash, muted, body)
            row += 1
            kr705Row(kr705Panel, row, "Entry", productionEntry, dash, muted, body)
            row += 1
            kr705Row(kr705Panel, row, "Decision", outDecisionText, outKR380CurrentPineStateContractInstance.displayLabel, muted, body)
            row += 1
            kr705Row(kr705Panel, row, "Need", productionNeed, v2Need, legacyNeed == "" ? muted : caution, body)
            row += 1
            kr705Row(kr705Panel, row, "Status", productionStatus, v2Status, legacyReady ? positive : caution, header)

    0

kr705Render()

//==================================================================
// END OF KR-705
//==================================================================
